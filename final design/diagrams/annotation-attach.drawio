<mxfile host="65bd71144e">
    <diagram id="annotation_attach" name="annotation_attach (post-onboarding)">
        <mxGraphModel dx="1502" dy="931" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1240" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="Annotation attach — multipart upload, queue, worker, overlay" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="40" y="20" width="1100" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="subtitle" value="POST /scenes/{id}/annotations stages a single mask file and enqueues an annotation_attach job. Worker moves the file, renders an RGBA overlay PNG, INSERTs Annotation + flips Scene.has_annotations atomically. Frontend polls the job, then reloads the annotation list. Synchronous DELETE removes row + files in one transaction." style="text;html=1;fontSize=12;fontStyle=2;fontColor=#666666;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="40" y="52" width="1400" height="40" as="geometry"/>
                </mxCell>
                <!-- Actors -->
                <mxCell id="actor_browser" value="Browser (AnnotationsPanel)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="80" y="105" width="220" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="actor_api" value="api (FastAPI)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="430" y="105" width="160" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="actor_data" value="allotrope_data + _artifacts (volumes)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8d5e8;strokeColor=#a874a8;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="700" y="105" width="220" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="actor_pg" value="postgres" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="1010" y="105" width="160" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="actor_worker" value="worker (annotation_attach handler)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="1230" y="105" width="240" height="40" as="geometry"/>
                </mxCell>
                <!-- Lifelines -->
                <mxCell id="ll_browser" style="endArrow=none;dashed=1;html=1;rounded=0;strokeColor=#999999;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="190" y="145" as="sourcePoint"/><mxPoint x="190" y="1190" as="targetPoint"/></mxGeometry>
                </mxCell>
                <mxCell id="ll_api" style="endArrow=none;dashed=1;html=1;rounded=0;strokeColor=#999999;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="510" y="145" as="sourcePoint"/><mxPoint x="510" y="1190" as="targetPoint"/></mxGeometry>
                </mxCell>
                <mxCell id="ll_data" style="endArrow=none;dashed=1;html=1;rounded=0;strokeColor=#999999;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="810" y="145" as="sourcePoint"/><mxPoint x="810" y="1190" as="targetPoint"/></mxGeometry>
                </mxCell>
                <mxCell id="ll_pg" style="endArrow=none;dashed=1;html=1;rounded=0;strokeColor=#999999;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="1090" y="145" as="sourcePoint"/><mxPoint x="1090" y="1190" as="targetPoint"/></mxGeometry>
                </mxCell>
                <mxCell id="ll_worker" style="endArrow=none;dashed=1;html=1;rounded=0;strokeColor=#999999;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="1350" y="145" as="sourcePoint"/><mxPoint x="1350" y="1190" as="targetPoint"/></mxGeometry>
                </mxCell>

                <!-- Phase 1: POST -->
                <mxCell id="phase1_band" value="① POST /scenes/{scene_id}/annotations — multipart" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef3f8;strokeColor=#aac4e0;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="30" y="170" width="1450" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="msg1_1" value="POST /api/scenes/scene_&amp;lt;uuid&amp;gt;/annotations&lt;br/&gt;Content-Type: multipart/form-data&lt;br/&gt;name, annotation_type=raster_mask, description?, file=&amp;lt;mask&amp;gt;&lt;br/&gt;Cookie: allotrope_jwt" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="190" y="240" as="sourcePoint"/><mxPoint x="510" y="240" as="targetPoint"/></mxGeometry>
                </mxCell>

                <!-- Phase 2: validate + stage -->
                <mxCell id="phase2_band" value="② Validate + stage to disk synchronously" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2e0;strokeColor=#e0b070;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="30" y="265" width="1450" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="note2" value="current_user_claims (JWT, no DB).&lt;br/&gt;db.get(Scene) — 404 scene_not_found if missing.&lt;br/&gt;annotation_type ∈ {raster_mask} else 422 unsupported_annotation_type.&lt;br/&gt;mkdir /data/staging/&amp;lt;job_id&amp;gt;/, sanitise filename, stream 1 MiB chunks." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="240" y="305" width="640" height="80" as="geometry"/>
                </mxCell>

                <!-- Phase 3: enqueue -->
                <mxCell id="phase3_band" value="③ Enqueue annotation_attach job + 202 response" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fbe5e5;strokeColor=#d09898;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="30" y="395" width="1450" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="msg3_1" value="INSERT jobs (id, type='annotation_attach', status='queued', payload={scene_id, name, filename, staging_dir, …})" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="510" y="455" as="sourcePoint"/><mxPoint x="1090" y="455" as="targetPoint"/></mxGeometry>
                </mxCell>
                <mxCell id="msg3_2" value="HTTP 202 { job_id, annotation_name }" style="endArrow=open;html=1;edgeStyle=none;dashed=1;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="510" y="490" as="sourcePoint"/><mxPoint x="190" y="490" as="targetPoint"/></mxGeometry>
                </mxCell>

                <!-- Phase 4: worker claim -->
                <mxCell id="phase4_band" value="④ Worker claim — see worker-loop.drawio for the full claim path" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5eef8;strokeColor=#c8a4d0;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="30" y="520" width="1450" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="msg4_1" value="claim_one() — row queued → running" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="1350" y="565" as="sourcePoint"/><mxPoint x="1090" y="565" as="targetPoint"/></mxGeometry>
                </mxCell>

                <!-- Phase 5: handler dispatches via the type registry -->
                <mxCell id="phase5_band" value="⑤ Handler — type registry dispatch (allotrope.annotation_types)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2e0;strokeColor=#e0b070;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="30" y="595" width="1450" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="msg5_1" value="spec = get_spec(annotation_type)  →  spec.materialise(staging_file, final_dir)&lt;br/&gt;e.g. raster_mask: shutil.move(staging/&amp;lt;job_id&amp;gt;/&amp;lt;file&amp;gt; → scenes/&amp;lt;scene_id&amp;gt;/annotations/&amp;lt;ann_id&amp;gt;/&amp;lt;file&amp;gt;)" style="endArrow=classic;html=1;edgeStyle=none;fontSize=10;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="1350" y="650" as="sourcePoint"/><mxPoint x="810" y="650" as="targetPoint"/></mxGeometry>
                </mxCell>
                <mxCell id="msg5_2" value="spec.render_overlay(final_file, dest_png, radius=None) → bool&lt;br/&gt;raster_mask: rasterio.read(1) → stride-slice (≤4096 px) → np.where(mask≠0) → dedup output coords → PIL.ImageDraw.ellipse stamp (cyan #00FFFF @ α=220, radius default 14 px)&lt;br/&gt;write artifacts/scenes/&amp;lt;scene_id&amp;gt;/annotations/&amp;lt;ann_id&amp;gt;/overlay.png" style="endArrow=classic;html=1;edgeStyle=none;dashed=1;fontSize=10;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="1350" y="685" as="sourcePoint"/><mxPoint x="810" y="685" as="targetPoint"/></mxGeometry>
                </mxCell>
                <mxCell id="note5" value="Per-type spec contract: KIND, LABEL, ACCEPTED_EXTENSIONS, validate_upload, materialise, render_overlay, extract_metadata.&lt;br/&gt;Render or metadata-extract fails → roll back the file move (rmtree of the new ann dir) and re-raise. The job lands in 'failed'; staging dir survives for diagnostics.&lt;br/&gt;spec.extract_metadata(final_file) → dict written into Annotation.metadata JSONB (raster_mask: anomaly_pixel_count, total_pixel_count, coverage_pct, shape)." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="120" y="710" width="900" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="msg5_3" value="INSERT INTO annotations (id, scene_id, type, name, description, file_path, metadata, …);  UPDATE scenes SET has_annotations=true WHERE id=:scene_id;  session.flush()" style="endArrow=classic;html=1;edgeStyle=none;fontSize=10;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="1350" y="775" as="sourcePoint"/><mxPoint x="1090" y="775" as="targetPoint"/></mxGeometry>
                </mxCell>

                <!-- Phase 6: finalize -->
                <mxCell id="phase6_band" value="⑥ mark_complete (atomic with the Annotation insert)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f1e6;strokeColor=#a8c8a4;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="30" y="800" width="1450" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="msg6_1" value="UPDATE jobs SET status='complete', target_kind='annotation', target_id=&amp;lt;ann_id&amp;gt;, completed_at=now();  COMMIT  →  publishes Annotation + has_annotations + Job lifecycle in one transaction" style="endArrow=classic;html=1;edgeStyle=none;fontSize=10;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="1350" y="855" as="sourcePoint"/><mxPoint x="1090" y="855" as="targetPoint"/></mxGeometry>
                </mxCell>

                <!-- Phase 7: client polling -->
                <mxCell id="phase7_band" value="⑦ Client polling (concurrent with ④–⑥) — GET /jobs/{job_id}" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fbe5e5;strokeColor=#d09898;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="30" y="885" width="1450" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="msg7_1" value="every ~2s: GET /api/jobs/job_&amp;lt;uuid&amp;gt;" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="190" y="940" as="sourcePoint"/><mxPoint x="510" y="940" as="targetPoint"/></mxGeometry>
                </mxCell>
                <mxCell id="msg7_2" value="JobPublic { status, target_kind='annotation', target_id, … }" style="endArrow=open;html=1;edgeStyle=none;dashed=1;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="510" y="975" as="sourcePoint"/><mxPoint x="190" y="975" as="targetPoint"/></mxGeometry>
                </mxCell>
                <mxCell id="msg7_3" value="on complete: GET /scenes/&amp;lt;id&amp;gt;/annotations  → reloadAnnotations() → overlays reflect the new layer in the centre viewport (toggle/opacity controls in the left rail)" style="endArrow=classic;html=1;edgeStyle=none;dashed=1;fontSize=10;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="190" y="1005" as="sourcePoint"/><mxPoint x="510" y="1005" as="targetPoint"/></mxGeometry>
                </mxCell>

                <!-- Phase 8: synchronous delete -->
                <mxCell id="phase8_band" value="⑧ DELETE /scenes/{id}/annotations/{ann_id} — synchronous (per spec § 5.3)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef3f8;strokeColor=#aac4e0;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="30" y="1035" width="1450" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="msg8_1" value="DELETE /api/scenes/&amp;lt;scene_id&amp;gt;/annotations/&amp;lt;ann_id&amp;gt;" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="190" y="1085" as="sourcePoint"/><mxPoint x="510" y="1085" as="targetPoint"/></mxGeometry>
                </mxCell>
                <mxCell id="msg8_2" value="DELETE annotations row → flush → recompute scenes.has_annotations from remaining rows → COMMIT  →  rmtree raw + artifacts dirs (after commit)" style="endArrow=classic;html=1;edgeStyle=none;fontSize=10;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="510" y="1120" as="sourcePoint"/><mxPoint x="1090" y="1120" as="targetPoint"/></mxGeometry>
                </mxCell>
                <mxCell id="msg8_3" value="HTTP 204 No Content" style="endArrow=open;html=1;edgeStyle=none;dashed=1;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="510" y="1150" as="sourcePoint"/><mxPoint x="190" y="1150" as="targetPoint"/></mxGeometry>
                </mxCell>

                <!-- Footer -->
                <mxCell id="footer" value="Type registry: GET /annotation-types returns the catalogue (KIND, LABEL, ACCEPTED_EXTENSIONS) the frontend uses to populate the form. v1 ships raster_mask only; future types per spec § 5.3 — multi_class_raster_mask, polygon_vector, point_features, bounding_boxes — slot in via single new module + registry entry on each side (api + worker import the same allotrope.annotation_types). Inference: POST omits annotation_type → api calls infer_kind_from_filename; ambiguous extensions return 422 ambiguous_or_unknown_type and the frontend exposes a disambiguation picker.&#10;Overlay endpoint: GET /annotations/{id}/overlay streams the worker-rendered RGBA PNG (Cache-Control: immutable). With ?radius=N the api re-renders ON DEMAND from the source mask file (rasterio + PIL.ImageDraw.ellipse), Cache-Control: max-age=86400 per radius — frontend slider drives this. Failure modes: 401 unauth → /login; 404 scene_not_found / annotation_not_found / source_unavailable; 422 unsupported_annotation_type / bad_filename / type-specific validation errors; worker raise → mark_failed (file move rolled back; staging dir kept for diagnostics)." style="text;html=1;fontSize=11;fontStyle=2;fontColor=#666666;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1180" width="1430" height="60" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>
