                    <mxGeometry x="940" y="85" width="240" height="40" as="geometry"/>
                </mxCell>

                <mxCell id="ll_op" style="endArrow=none;dashed=1;html=1;rounded=0;strokeColor=#999999;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="140" y="125" as="sourcePoint"/><mxPoint x="140" y="660" as="targetPoint"/></mxGeometry>
                </mxCell>
                <mxCell id="ll_cli" style="endArrow=none;dashed=1;html=1;rounded=0;strokeColor=#999999;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="440" y="125" as="sourcePoint"/><mxPoint x="440" y="660" as="targetPoint"/></mxGeometry>
                </mxCell>
                <mxCell id="ll_reg" style="endArrow=none;dashed=1;html=1;rounded=0;strokeColor=#999999;" parent="1" edge="1">
