                </mxCell>
                <mxCell id="ll_pg" style="endArrow=none;dashed=1;html=1;rounded=0;strokeColor=#999999;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="1060" y="125" as="sourcePoint"/><mxPoint x="1060" y="660" as="targetPoint"/></mxGeometry>
                </mxCell>

                <mxCell id="phase1" value="① Invocation" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef3f8;strokeColor=#aac4e0;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="30" y="150" width="1340" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="msg1" value="docker compose run --rm api python -m allotrope.cli seed-action-templates" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="140" y="200" as="sourcePoint"/><mxPoint x="440" y="200" as="targetPoint"/></mxGeometry>
                </mxCell>

                <mxCell id="phase2" value="② Walk REGISTRY × default_config_per_sensor" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2e0;strokeColor=#e0b070;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="30" y="225" width="1340" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="msg2a" value="for kind, spec in sorted(REGISTRY.items()): for sensor, default_cfg in sorted(spec.META.default_config_per_sensor.items()): …" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="440" y="270" as="sourcePoint"/><mxPoint x="760" y="270" as="targetPoint"/></mxGeometry>
                </mxCell>
                <mxCell id="msg2b" value="name = f&quot;{META.label} · default · {SENSOR_LABEL}&quot; · description = f&quot;System default for {sensor} scenes. {META.short_description}&quot;" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontStyle=2;fontColor=#444444;" parent="1" vertex="1">
                    <mxGeometry x="200" y="295" width="1100" height="20" as="geometry"/>
                </mxCell>

                <mxCell id="phase3" value="③ Upsert: lookup by (type, name, is_system=True), insert / update / skip-unchanged" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0e0f0;strokeColor=#b070b0;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="30" y="325" width="1340" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="msg3a" value="SELECT * FROM action_templates WHERE type=… AND name=… AND is_system=true LIMIT 1" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="440" y="375" as="sourcePoint"/><mxPoint x="1060" y="375" as="targetPoint"/></mxGeometry>
                </mxCell>
                <mxCell id="msg3b" value="branch A · row absent → INSERT action_templates(type, name, description, configuration, is_system=true)" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="440" y="410" as="sourcePoint"/><mxPoint x="1060" y="410" as="targetPoint"/></mxGeometry>
                </mxCell>
                <mxCell id="msg3c" value="branch B · row present AND drifted → UPDATE configuration, description, updated_at=NOW()" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="440" y="445" as="sourcePoint"/><mxPoint x="1060" y="445" as="targetPoint"/></mxGeometry>
                </mxCell>
                <mxCell id="msg3d" value="branch C · row present AND identical → no-op" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontStyle=2;fontColor=#888888;" parent="1" vertex="1">
                    <mxGeometry x="200" y="475" width="700" height="20" as="geometry"/>
                </mxCell>

                <mxCell id="phase4" value="④ Commit + summary line" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="30" y="505" width="1340" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="msg4a" value="session.commit()" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="440" y="555" as="sourcePoint"/><mxPoint x="1060" y="555" as="targetPoint"/></mxGeometry>
                </mxCell>
                <mxCell id="msg4b" value="stdout: &apos;Seeded action templates: N new · M updated · K unchanged&apos;" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="440" y="590" as="sourcePoint"/><mxPoint x="140" y="590" as="targetPoint"/></mxGeometry>
                </mxCell>

                <mxCell id="note" value="Idempotency: re-running picks up META drift (a code change to default_config_per_sensor propagates without manual DB cleanup). User-saved templates (is_system=false) are never touched. Pairs naturally with seed-admin in a bootstrap script — both are safe to chain." style="text;html=1;fontSize=10;align=left;verticalAlign=top;fillColor=#fafafa;strokeColor=#cccccc;fontColor=#444444;" parent="1" vertex="1">
                    <mxGeometry x="40" y="615" width="1320" height="40" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
