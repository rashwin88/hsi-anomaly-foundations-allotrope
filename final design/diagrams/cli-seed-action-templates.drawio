                <mxCell id="title" value="CLI seed-action-templates — upsert one ActionTemplate per (action type × applicable sensor)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="40" y="20" width="1320" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="subtitle" value="Idempotent. Reads each action_types module&apos;s META.default_config_per_sensor and materialises a row with is_system=True. User-saved templates (is_system=False) are never touched." style="text;html=1;fontSize=12;fontStyle=2;fontColor=#666666;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="40" y="52" width="1320" height="20" as="geometry"/>
                </mxCell>

                <mxCell id="actor_op" value="Operator (shell)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="60" y="85" width="160" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="actor_cli" value="python -m allotrope.cli seed-action-templates" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="280" y="85" width="320" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="actor_reg" value="action_types REGISTRY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=1;" parent="1" vertex="1">
