                    </mxGeometry>
                </mxCell>
                <mxCell id="phase1_band" value="① Invocation — docker compose run --rm api ..." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef3f8;strokeColor=#aac4e0;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="30" y="140" width="1430" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="msg1_1" value="docker compose run --rm api python -m allotrope.cli seed-admin" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="200" y="195" as="sourcePoint"/>
                        <mxPoint x="560" y="195" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="msg1_2" value="spawn one-shot container from api image&lt;br/&gt;CMD overridden: python -m allotrope.cli seed-admin" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="560" y="240" as="sourcePoint"/>
                        <mxPoint x="920" y="240" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="note1" value="container starts:&lt;br/&gt;· env loaded from compose (POSTGRES_*, ADMIN_*, JWT_SECRET)&lt;br/&gt;· python imports allotrope.cli&lt;br/&gt;· typer app dispatches to seed_admin()" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="730" y="270" width="380" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="phase2_band" value="② Validate inputs — pre-flight checks before touching the DB" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2e0;strokeColor=#e0b070;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="30" y="375" width="1430" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="note2" value="seed_admin() checks settings.admin_username, admin_email, admin_password.&lt;br/&gt;If any is missing → typer.secho(red, err=True) + raise typer.Exit(1). Container exits non-zero." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="730" y="412" width="430" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="phase3_band" value="③ Idempotency check — does an admin already exist?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f1e6;strokeColor=#a8c8a4;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="30" y="495" width="1430" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="msg3_1" value="SessionLocal() → engine.connect() → SELECT * FROM users WHERE is_admin=TRUE LIMIT 1" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="920" y="550" as="sourcePoint"/>
                        <mxPoint x="1280" y="550" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="msg3_2" value="rows" style="endArrow=open;html=1;edgeStyle=none;dashed=1;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="1280" y="585" as="sourcePoint"/>
                        <mxPoint x="920" y="585" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="branch_label" value="&lt;b&gt;branches:&lt;/b&gt;" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontColor=#444;" parent="1" vertex="1">
                    <mxGeometry x="40" y="610" width="100" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="branch_a" value="&lt;b&gt;A. row exists&lt;/b&gt; — admin already created (re-run case)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#cccccc;align=left;verticalAlign=middle;fontStyle=0;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="150" y="605" width="600" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="branch_a_msg" value="stdout: &amp;quot;Admin already exists: ... (id=...)&amp;quot; → exit 0" style="endArrow=open;html=1;edgeStyle=none;dashed=1;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;strokeColor=#888888;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="920" y="650" as="sourcePoint"/>
                        <mxPoint x="200" y="650" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="branch_b" value="&lt;b&gt;B. row empty&lt;/b&gt; — first-run case; create the admin (steps below)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#cccccc;align=left;verticalAlign=middle;fontStyle=0;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="150" y="685" width="600" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="phase4_band" value="④ Create admin (first run only)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5eef8;strokeColor=#c8a4d0;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="30" y="730" width="1430" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="note4" value="&lt;b&gt;hash_password(ADMIN_PASSWORD)&lt;/b&gt;&lt;br/&gt;argon2id with strong defaults (memory=64MB, time=3, parallelism=4).&lt;br/&gt;Local computation — no I/O. Output is one PHC string (~97 chars).&lt;br/&gt;Build User instance with is_admin=True." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="730" y="767" width="430" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="msg4_1" value="INSERT INTO users (id, username, email, password_hash, is_admin, created_at, updated_at) VALUES (...)" style="endArrow=classic;html=1;edgeStyle=none;fontSize=10;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="920" y="880" as="sourcePoint"/>
                        <mxPoint x="1280" y="880" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="msg4_2" value="1 row inserted" style="endArrow=open;html=1;edgeStyle=none;dashed=1;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="1280" y="915" as="sourcePoint"/>
                        <mxPoint x="920" y="915" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="msg4_3" value="session.commit() · session.refresh(user)" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="920" y="950" as="sourcePoint"/>
                        <mxPoint x="1280" y="950" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="msg4_4" value="stdout: &amp;quot;Created admin: admin &amp;lt;admin@allotrope.local&amp;gt; (id=...)&amp;quot; → exit 0" style="endArrow=open;html=1;edgeStyle=none;dashed=1;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="920" y="990" as="sourcePoint"/>
                        <mxPoint x="200" y="990" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="phase5_band" value="⑤ Cleanup — --rm flag removes the container after exit" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#cccccc;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="30" y="1025" width="1430" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="footer" value="Idempotent: the SELECT in ③ ensures re-runs short-circuit. Safe to wire into a future bootstrap one-shot service. Password hashing happens entirely on the api side; postgres only ever sees the encoded hash, never the plaintext." style="text;html=1;fontSize=11;fontStyle=2;fontColor=#666666;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="80" y="1062" width="1340" height="40" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
