<mxfile host="65bd71144e">
    <diagram id="anomaly_detection_recipe" name="anomaly_detection.run recipe">
        <mxGraphModel dx="1502" dy="931" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="900" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="action_types.anomaly_detection.run — multi-model fan-out · per-model scoring · optional ROC vs GT" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="40" y="20" width="1420" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="subtitle" value="One Action selects 1..N models from the codename catalog (Indradhanu / Chakshu / Pratibimba / …). Each picked model is loaded in turn through the inferencer factory, scores the same filtered cube + keep_mask, writes a per-model anomaly_score.tif. When a GT annotation is attached, the worker computes per-model ROC + AUC." style="text;html=1;fontSize=12;fontStyle=2;fontColor=#666666;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="40" y="52" width="1420" height="20" as="geometry"/>
                </mxCell>

                <mxCell id="actor_handler" value="anomaly_detection.run(ctx)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="60" y="85" width="240" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="actor_resolver" value="foundation_models.resolver" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="360" y="85" width="220" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="actor_factory" value="app.foundation_models.inferencer_factory" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="640" y="85" width="280" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="actor_score" value="utils.anomaly_detection.scoring" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="970" y="85" width="240" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="actor_fs" value="filesystem (output_dir + upstream pickles)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="1250" y="85" width="220" height="40" as="geometry"/>
                </mxCell>

                <mxCell id="ll_handler" style="endArrow=none;dashed=1;html=1;rounded=0;strokeColor=#999999;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="180" y="125" as="sourcePoint"/><mxPoint x="180" y="860" as="targetPoint"/></mxGeometry>
                </mxCell>
                <mxCell id="ll_resolver" style="endArrow=none;dashed=1;html=1;rounded=0;strokeColor=#999999;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="470" y="125" as="sourcePoint"/><mxPoint x="470" y="860" as="targetPoint"/></mxGeometry>
                </mxCell>
                <mxCell id="ll_factory" style="endArrow=none;dashed=1;html=1;rounded=0;strokeColor=#999999;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="780" y="125" as="sourcePoint"/><mxPoint x="780" y="860" as="targetPoint"/></mxGeometry>
                </mxCell>
                <mxCell id="ll_score" style="endArrow=none;dashed=1;html=1;rounded=0;strokeColor=#999999;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="1090" y="125" as="sourcePoint"/><mxPoint x="1090" y="860" as="targetPoint"/></mxGeometry>
                </mxCell>
                <mxCell id="ll_fs" style="endArrow=none;dashed=1;html=1;rounded=0;strokeColor=#999999;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="1360" y="125" as="sourcePoint"/><mxPoint x="1360" y="860" as="targetPoint"/></mxGeometry>
                </mxCell>

                <mxCell id="phase1" value="① Load upstream artifacts" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef3f8;strokeColor=#aac4e0;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="30" y="150" width="1460" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="msg1a" value="filtered_vendable.pkl ← upstream band_filter_apply Output (ctx.resolve_action_output)" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="180" y="200" as="sourcePoint"/><mxPoint x="1360" y="200" as="targetPoint"/></mxGeometry>
                </mxCell>
                <mxCell id="msg1b" value="keep_mask.tif (optional) ← scene_segmentation Output · AND with spatial validity" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;dashed=1;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="180" y="232" as="sourcePoint"/><mxPoint x="1360" y="232" as="targetPoint"/></mxGeometry>
                </mxCell>
                <mxCell id="msg1c" value="gt raster (optional) ← scenes/&amp;lt;id&amp;gt;/annotations/&amp;lt;ann&amp;gt;/*.tif → binary uint8" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;dashed=1;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="180" y="262" as="sourcePoint"/><mxPoint x="1360" y="262" as="targetPoint"/></mxGeometry>
                </mxCell>

                <mxCell id="phase2" value="② Fan out: for each codename ∈ configuration.model_codenames" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2e0;strokeColor=#e0b070;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="30" y="290" width="1460" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="msg2a" value="resolve(codename) → architecture · checkpoint_path · ModelSpecificConfig · scoring_methods · default_scoring_method" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="180" y="335" as="sourcePoint"/><mxPoint x="470" y="335" as="targetPoint"/></mxGeometry>
                </mxCell>
                <mxCell id="msg2b" value="method = scoring_overrides[codename] ?? model.default_scoring_method" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontStyle=2;fontColor=#444444;" parent="1" vertex="1">
                    <mxGeometry x="220" y="360" width="700" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="msg2c" value="get_inferencer(InferenceConfig(...)) — loads checkpoint to device · sets eval()" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="180" y="395" as="sourcePoint"/><mxPoint x="780" y="395" as="targetPoint"/></mxGeometry>
                </mxCell>

                <mxCell id="phase3" value="③ predict_full_scene → reconstruction (heavy step; minutes per model)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0e0f0;strokeColor=#b070b0;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="30" y="425" width="1460" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="msg3a" value="inferencer.predict_full_scene(scene_tensor, mask_tensor)  — patch loop · two-pass checkerboard · overlap-average" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="180" y="475" as="sourcePoint"/><mxPoint x="780" y="475" as="targetPoint"/></mxGeometry>
                </mxCell>
                <mxCell id="msg3b" value="ctx.on_step(f&apos;model={codename} · patch={i}/{N}&apos;) — refreshes jobs.last_heartbeat_at so the reaper doesn&apos;t mark stale" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontStyle=2;fontColor=#444444;" parent="1" vertex="1">
                    <mxGeometry x="220" y="500" width="900" height="20" as="geometry"/>
                </mxCell>

                <mxCell id="phase4" value="④ Score · threshold · per-model raster writes" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fbe5d6;strokeColor=#d99458;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="30" y="530" width="1460" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="msg4a" value="compute_score(original, reconstruction, keep_mask, method) → (H, W) float32 — L1 · MSE · SAM · combined" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="180" y="580" as="sourcePoint"/><mxPoint x="1090" y="580" as="targetPoint"/></mxGeometry>
                </mxCell>
                <mxCell id="msg4b" value="threshold = np.percentile(score[kept], detection_percentile) → detections = (score ≥ threshold) ∧ kept" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontStyle=2;fontColor=#444444;" parent="1" vertex="1">
                    <mxGeometry x="220" y="605" width="900" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="msg4c" value="write models/&amp;lt;codename&amp;gt;/anomaly_score.tif (float32) · detections.tif (uint8) · stats.json (timings · score percentiles · AUC)" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="180" y="640" as="sourcePoint"/><mxPoint x="1360" y="640" as="targetPoint"/></mxGeometry>
                </mxCell>

                <mxCell id="phase5" value="⑤ ROC vs GT (only when input_annotation_id is attached)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe2e0;strokeColor=#d99494;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="30" y="670" width="1460" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="msg5" value="compute_roc(score, gt, keep_mask) → FPR · TPR · AUC · degenerate-flag (when GT has 0 positives or 0 negatives in the kept region)" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;dashed=1;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="180" y="720" as="sourcePoint"/><mxPoint x="1090" y="720" as="targetPoint"/></mxGeometry>
                </mxCell>

                <mxCell id="phase6" value="⑥ Render heatmap montage + write summary.json + diagnostics.json (+ roc.json when GT)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="30" y="750" width="1460" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="msg6a" value="matplotlib: RGB scene + N heatmap panels (inferno, per-panel 99.5p colour cap) → preview.png" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="180" y="800" as="sourcePoint"/><mxPoint x="1360" y="800" as="targetPoint"/></mxGeometry>
                </mxCell>
                <mxCell id="msg6b" value="summary.json (lean: n_models · scene_shape · band_count · kept_pct · per-model {codename, method, auc, infer_seconds, detection_pixels})" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontStyle=2;fontColor=#444444;" parent="1" vertex="1">
                    <mxGeometry x="220" y="825" width="1140" height="20" as="geometry"/>
                </mxCell>

                <mxCell id="note" value="Invariants: free model + cuda cache between codenames so memory doesn&apos;t pile up. ROC is omitted (roc.json absent) when no GT was attached. Cancellation hooks at every ctx.on_step boundary — when wired in, worker breaks the per-model loop mid-codename." style="text;html=1;fontSize=10;align=left;verticalAlign=top;fillColor=#fafafa;strokeColor=#cccccc;fontColor=#444444;" parent="1" vertex="1">
                    <mxGeometry x="40" y="855" width="1450" height="40" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>
