<mxfile host="65bd71144e">
    <diagram id="admin_create_user" name="POST /admin/users">
        <mxGraphModel dx="1502" dy="931" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1100" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="POST /admin/users — implementation sequence" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="40" y="20" width="800" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="subtitle" value="Admin-only create-user. Two auth gates compose: current_user_claims (must be authenticated) → require_admin (must have is_admin). Then validate, INSERT, handle race." style="text;html=1;fontSize=12;fontStyle=2;fontColor=#666666;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="40" y="52" width="1300" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="actor_browser" value="Browser (Client)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="120" y="85" width="160" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="actor_api" value="api (FastAPI)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="520" y="85" width="160" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="actor_pg" value="postgres" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="920" y="85" width="160" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="ll_browser" style="endArrow=none;dashed=1;html=1;rounded=0;strokeColor=#999999;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="200" y="125" as="sourcePoint"/>
                        <mxPoint x="200" y="1040" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="ll_api" style="endArrow=none;dashed=1;html=1;rounded=0;strokeColor=#999999;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="600" y="125" as="sourcePoint"/>
                        <mxPoint x="600" y="1040" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="ll_pg" style="endArrow=none;dashed=1;html=1;rounded=0;strokeColor=#999999;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="1000" y="125" as="sourcePoint"/>
                        <mxPoint x="1000" y="1040" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="phase1_band" value="① Request" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef3f8;strokeColor=#aac4e0;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="30" y="140" width="1200" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="msg1_1" value="POST /admin/users&lt;br/&gt;Cookie: allotrope_jwt=&amp;lt;jwt&amp;gt;&lt;br/&gt;{ username, email, password, display_name?, is_admin? }" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="200" y="210" as="sourcePoint"/>
                        <mxPoint x="600" y="210" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="phase2_band" value="② Auth gate 1: current_user_claims — must be authenticated" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2e0;strokeColor=#e0b070;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="30" y="245" width="1200" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="note2" value="Read cookie → decode JWT → verify signature + exp.&lt;br/&gt;On failure: 401 unauthenticated / session_expired (handler never runs).&lt;br/&gt;&lt;b&gt;No DB read.&lt;/b&gt;" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="430" y="285" width="600" height="65" as="geometry"/>
                </mxCell>
                <mxCell id="phase3_band" value="③ Auth gate 2: require_admin — must have is_admin=true" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f1e6;strokeColor=#a8c8a4;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="30" y="365" width="1200" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="note3" value="if not claims[&amp;quot;is_admin&amp;quot;]: raise 403 forbidden&lt;br/&gt;is_admin lives in the JWT claims (set at login from User.is_admin), so this check is also DB-free.&lt;br/&gt;&lt;b&gt;401 vs 403:&lt;/b&gt; 401 = not logged in; 403 = logged in but lacks privilege. Distinct semantics, distinct frontend handling." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="430" y="405" width="600" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="branch_label" value="&lt;b&gt;Failure branches (handler never runs):&lt;/b&gt;" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontColor=#444;" parent="1" vertex="1">
                    <mxGeometry x="40" y="500" width="400" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="branch_a" value="no/bad cookie → 401 { detail: &amp;quot;unauthenticated&amp;quot; }" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#cccccc;align=left;verticalAlign=middle;fontStyle=0;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="80" y="528" width="500" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="branch_b" value="expired cookie → 401 { detail: &amp;quot;session_expired&amp;quot; }" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#cccccc;align=left;verticalAlign=middle;fontStyle=0;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="80" y="560" width="500" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="branch_c" value="logged in but is_admin=false → 403 { detail: &amp;quot;forbidden&amp;quot; }" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#cccccc;align=left;verticalAlign=middle;fontStyle=0;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="80" y="592" width="500" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="phase4_band" value="④ Validate input + hash password" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5eef8;strokeColor=#c8a4d0;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="30" y="635" width="1200" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="note4" value="Pydantic validates: username 1..128 chars, email 3..256, password ≥8, etc.&lt;br/&gt;On failure: 422 Unprocessable Entity with field-level details (FastAPI default).&lt;br/&gt;Then hash_password(payload.password) → argon2id PHC string. Local; no I/O." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="430" y="675" width="600" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="phase5_band" value="⑤ INSERT — let the unique index catch races" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2e0;strokeColor=#e0b070;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="30" y="770" width="1200" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="msg5_1" value="INSERT INTO users (id, username, email, password_hash, display_name, is_admin, ...)&lt;br/&gt;VALUES (...) RETURNING *" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="600" y="845" as="sourcePoint"/>
                        <mxPoint x="1000" y="845" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="msg5_2" value="row | unique-violation on LOWER(username) or LOWER(email)" style="endArrow=open;html=1;edgeStyle=none;dashed=1;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="1000" y="880" as="sourcePoint"/>
                        <mxPoint x="600" y="880" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="conflict_branch" value="On IntegrityError → rollback → 409 { detail: &amp;quot;username_or_email_taken&amp;quot; }" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#cccccc;align=left;verticalAlign=middle;fontStyle=0;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="80" y="910" width="640" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="phase6_band" value="⑥ Respond — created user (no password fields)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f1e6;strokeColor=#a8c8a4;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="30" y="950" width="1200" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="msg6_1" value="HTTP 201&lt;br/&gt;{ id: user_&amp;lt;uuid&amp;gt;, username, email, display_name, is_admin }" style="endArrow=open;html=1;edgeStyle=none;dashed=1;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="600" y="1015" as="sourcePoint"/>
                        <mxPoint x="200" y="1015" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="footer" value="No pre-check SELECT — we trust the unique constraints on LOWER(username) and LOWER(email) to catch both initial collisions AND races between concurrent admin requests. The IntegrityError handler does the translation to 409. Password is never echoed back; UserPublic excludes password_hash by design." style="text;html=1;fontSize=11;fontStyle=2;fontColor=#666666;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="80" y="1050" width="1340" height="40" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>
