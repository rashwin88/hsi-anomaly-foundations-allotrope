<mxfile host="65bd71144e">
    <diagram id="action_templates_crud" name="action templates CRUD (Step 18)">
        <mxGraphModel dx="1502" dy="931" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="900" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="Action templates — system seed + user CRUD" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="40" y="20" width="1100" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="subtitle" value="System templates are seeded once at bootstrap from each action_types module's META.default_config_per_sensor (is_system=True, immutable). User templates land via POST /action-templates with whatever configuration body the NewActionDialog last produced; rename / re-describe / re-configure via PATCH; DELETE removes them and the backing FK on actions.action_template_id goes SET NULL so the audit trail survives. The api rejects PATCH/DELETE on system rows with 409 system_template_immutable so the demo recipe can't be tampered with." style="text;html=1;fontSize=12;fontStyle=2;fontColor=#666666;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="40" y="52" width="1400" height="70" as="geometry"/>
                </mxCell>

                <!-- Actors -->
                <mxCell id="actor_browser" value="Browser (ActionTemplatesPanel)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="80" y="135" width="280" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="actor_api" value="api (FastAPI)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="560" y="135" width="160" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="actor_pg" value="postgres" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="1100" y="135" width="160" height="40" as="geometry"/>
                </mxCell>

                <!-- Lifelines -->
                <mxCell id="ll_browser" style="endArrow=none;dashed=1;html=1;rounded=0;strokeColor=#999999;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="220" y="175" as="sourcePoint"/><mxPoint x="220" y="860" as="targetPoint"/></mxGeometry>
                </mxCell>
                <mxCell id="ll_api" style="endArrow=none;dashed=1;html=1;rounded=0;strokeColor=#999999;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="640" y="175" as="sourcePoint"/><mxPoint x="640" y="860" as="targetPoint"/></mxGeometry>
                </mxCell>
                <mxCell id="ll_pg" style="endArrow=none;dashed=1;html=1;rounded=0;strokeColor=#999999;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="1180" y="175" as="sourcePoint"/><mxPoint x="1180" y="860" as="targetPoint"/></mxGeometry>
                </mxCell>

                <!-- Phase 1 -->
                <mxCell id="phase1" value="① GET /action-templates — list (system first, then user templates by recency)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef3f8;strokeColor=#aac4e0;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="30" y="200" width="1450" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="msg1" value="GET /api/action-templates&lt;br/&gt;SELECT * FROM action_templates ORDER BY is_system DESC, updated_at DESC;" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="220" y="260" as="sourcePoint"/><mxPoint x="640" y="260" as="targetPoint"/></mxGeometry>
                </mxCell>

                <!-- Phase 2 -->
                <mxCell id="phase2" value="② POST /action-templates — create a user template (is_system=False)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2e0;strokeColor=#e0b070;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="30" y="295" width="1450" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="note2" value="Validate type ∈ action_types.REGISTRY → 422 unknown_action_type otherwise. Configuration body is NOT validated here — config shape depends on the target Scene's sensor, which a template isn't bound to. The Action submit flow re-validates at use time." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="260" y="330" width="800" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="msg2" value="INSERT INTO action_templates (id, type, name, description, configuration, is_system=false);&lt;br/&gt;COMMIT; RETURNING row" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="640" y="420" as="sourcePoint"/><mxPoint x="1180" y="420" as="targetPoint"/></mxGeometry>
                </mxCell>

                <!-- Phase 3 -->
                <mxCell id="phase3" value="③ PATCH /action-templates/{id} — system rows return 409" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6f3e6;strokeColor=#82b366;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="30" y="450" width="1450" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="note3" value="db.get(ActionTemplate) → 404 template_not_found if missing.&lt;br/&gt;is_system=True → 409 system_template_immutable (the seed recipes the demo shipped with stay frozen).&lt;br/&gt;Otherwise apply provided fields (name / description / configuration); updated_at touches via onupdate." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="260" y="485" width="800" height="70" as="geometry"/>
                </mxCell>

                <!-- Phase 4 -->
                <mxCell id="phase4" value="④ DELETE /action-templates/{id} — SET NULL ripples to actions.action_template_id" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3e6f3;strokeColor=#a874a8;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="30" y="580" width="1450" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="msg4" value="DELETE FROM action_templates WHERE id = ...;&lt;br/&gt;FK actions.action_template_id ON DELETE SET NULL — past Actions retain their&lt;br/&gt;configuration JSONB as the canonical audit record; the template_id link clears." style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="640" y="660" as="sourcePoint"/><mxPoint x="1180" y="660" as="targetPoint"/></mxGeometry>
                </mxCell>

                <!-- Phase 5 -->
                <mxCell id="phase5" value="⑤ NewActionDialog consumes the same /action-templates list as a picker" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef3f8;strokeColor=#aac4e0;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="30" y="695" width="1450" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="note5" value="Picking a template stamps its configuration into the submit payload; on Action submit the api persists configuration as a snapshot AND records action_template_id as an audit trail. Template churn doesn't rewrite history." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="80" y="730" width="1100" height="60" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>
