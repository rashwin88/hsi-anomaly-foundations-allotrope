                </mxCell>
                <mxCell id="subtitle" value="Action lifecycle starts here. status='queued' Action row + status='queued' Job row are written together; the worker picks up the Job and keeps actions.status / jobs.status in lockstep at every transition (Step 12d)." style="text;html=1;fontSize=12;fontStyle=2;fontColor=#666666;align=left;verticalAlign=middle;" parent="1" vertex="1">
