                <mxCell id="phase1" value="① Request" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef3f8;strokeColor=#aac4e0;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="30" y="150" width="1460" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="msg1" value="POST /api/projects/project_&amp;lt;uuid&amp;gt;/actions&lt;br/&gt;{ type, configuration, action_template_id? } — Cookie: allotrope_jwt" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="190" y="210" as="sourcePoint"/><mxPoint x="500" y="210" as="targetPoint"/></mxGeometry>
                </mxCell>

                <mxCell id="phase2" value="② Auth + load Project &amp; Scene" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2e0;strokeColor=#e0b070;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="30" y="240" width="1460" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="msg2a" value="db.get(Project, project_uuid)  → 404 project_not_found" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="500" y="290" as="sourcePoint"/><mxPoint x="1230" y="290" as="targetPoint"/></mxGeometry>
                </mxCell>
                <mxCell id="msg2b" value="db.get(Scene, project.scene_id)  → sensor_type drives validate_config" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="500" y="320" as="sourcePoint"/><mxPoint x="1230" y="320" as="targetPoint"/></mxGeometry>
                </mxCell>

                <mxCell id="phase3" value="③ Resolve action type + validate configuration" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0e0f0;strokeColor=#b070b0;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="30" y="345" width="1460" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="msg3a" value="get_spec(payload.type)  → 404 unknown_action_type:&amp;lt;type&amp;gt;" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="500" y="395" as="sourcePoint"/><mxPoint x="800" y="395" as="targetPoint"/></mxGeometry>
                </mxCell>
                <mxCell id="msg3b" value="spec.validate_config(raw_cfg, sensor_type)  → 422 on shape error / sensor mismatch" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="500" y="425" as="sourcePoint"/><mxPoint x="800" y="425" as="targetPoint"/></mxGeometry>
                </mxCell>
                <mxCell id="msg3c" value="validated cfg dict" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;dashed=1;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="800" y="455" as="sourcePoint"/><mxPoint x="500" y="455" as="targetPoint"/></mxGeometry>
                </mxCell>

                <mxCell id="phase4" value="④ Cross-field semantic checks (api owns membership; type owns shape)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fbe5d6;strokeColor=#d99458;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="30" y="480" width="1460" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="msg4a" value="assert configuration.input_scene_id == project.scene_id  → 422" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontStyle=2;fontColor=#444444;" parent="1" vertex="1">
                    <mxGeometry x="220" y="515" width="700" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="msg4b" value="if input_band_filter_output_id present: db.get(ActionOutput) → assert ref_action.project_id==project.id AND ref_action.status=='complete' → else 422 input_band_filter_output_id_not_usable" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="500" y="555" as="sourcePoint"/><mxPoint x="1230" y="555" as="targetPoint"/></mxGeometry>
                </mxCell>
                <mxCell id="msg4c" value="if action_template_id present: db.get(ActionTemplate) → assert template.type == payload.type → else 422" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="500" y="585" as="sourcePoint"/><mxPoint x="1230" y="585" as="targetPoint"/></mxGeometry>
                </mxCell>

                <mxCell id="phase5" value="⑤ INSERT Action + Job (one transaction)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="30" y="610" width="1460" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="msg5a" value="INSERT actions(id, project_id, action_template_id?, type, configuration, status='queued', created_at)" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="500" y="660" as="sourcePoint"/><mxPoint x="1230" y="660" as="targetPoint"/></mxGeometry>
                </mxCell>
                <mxCell id="msg5b" value="INSERT jobs(id, type='action_run', status='queued', project_id, target_kind='action', target_id=action.id, payload={action_id, project_id, scene_id, action_type})" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="500" y="695" as="sourcePoint"/><mxPoint x="1230" y="695" as="targetPoint"/></mxGeometry>
                </mxCell>
                <mxCell id="msg5c" value="COMMIT" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="500" y="725" as="sourcePoint"/><mxPoint x="1230" y="725" as="targetPoint"/></mxGeometry>
                </mxCell>

                <mxCell id="phase6" value="⑥ Response" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="30" y="750" width="1460" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="msg6" value="201 — ActionPublic { id=action_&amp;lt;uuid&amp;gt;, status='queued', configuration, … }" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="500" y="800" as="sourcePoint"/><mxPoint x="190" y="800" as="targetPoint"/></mxGeometry>
                </mxCell>

                <mxCell id="note" value="Errors: 401 (auth) · 404 project_not_found · 404 unknown_action_type:&amp;lt;type&amp;gt; · 422 (shape via Pydantic / sensor mismatch / cross-field membership) · 500 scene_missing_for_project (RESTRICT-FK guard).&lt;br/&gt;Invariants: Action insert and Job insert are atomic (single COMMIT). Job.target_kind=&apos;action&apos; + target_id=action.id is the soft polymorphic ref the worker uses to load the Action after claim." style="text;html=1;fontSize=10;align=left;verticalAlign=top;fillColor=#fafafa;strokeColor=#cccccc;fontColor=#444444;" parent="1" vertex="1">
                    <mxGeometry x="40" y="822" width="1450" height="55" as="geometry"/>
                </mxCell>
