<mxfile host="65bd71144e">
    <diagram id="visualization_save" name="visualization save (Step 15, scoped)">
        <mxGraphModel dx="1502" dy="931" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="900" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="Visualization save — synchronous flatten-and-pin" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="40" y="20" width="1100" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="subtitle" value="POST /projects/{id}/visualizations is multipart: a flattened viewer PNG + JSON metadata (source pointer, name, view_state). The api validates the source belongs to the project, writes the PNG under projects/&lt;pid&gt;/visualizations/&lt;vid&gt;/image.png, INSERTs the row, returns the wire object. No worker, no job. Scope cut 2026-05-11: VisualizationTemplate is NOT in v1 — each Action ships its own viewer with sensible defaults." style="text;html=1;fontSize=12;fontStyle=2;fontColor=#666666;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="40" y="52" width="1400" height="55" as="geometry"/>
                </mxCell>

                <!-- Actors -->
                <mxCell id="actor_browser" value="Browser (anomaly viewer modal)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="80" y="115" width="240" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="actor_api" value="api (FastAPI)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="510" y="115" width="160" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="actor_data" value="allotrope_artifacts (volume)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8d5e8;strokeColor=#a874a8;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="820" y="115" width="220" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="actor_pg" value="postgres" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="1180" y="115" width="160" height="40" as="geometry"/>
                </mxCell>

                <!-- Lifelines -->
                <mxCell id="ll_browser" style="endArrow=none;dashed=1;html=1;rounded=0;strokeColor=#999999;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="200" y="155" as="sourcePoint"/><mxPoint x="200" y="860" as="targetPoint"/></mxGeometry>
                </mxCell>
                <mxCell id="ll_api" style="endArrow=none;dashed=1;html=1;rounded=0;strokeColor=#999999;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="590" y="155" as="sourcePoint"/><mxPoint x="590" y="860" as="targetPoint"/></mxGeometry>
                </mxCell>
                <mxCell id="ll_data" style="endArrow=none;dashed=1;html=1;rounded=0;strokeColor=#999999;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="930" y="155" as="sourcePoint"/><mxPoint x="930" y="860" as="targetPoint"/></mxGeometry>
                </mxCell>
                <mxCell id="ll_pg" style="endArrow=none;dashed=1;html=1;rounded=0;strokeColor=#999999;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="1260" y="155" as="sourcePoint"/><mxPoint x="1260" y="860" as="targetPoint"/></mxGeometry>
                </mxCell>

                <!-- Phase 1: compose -->
                <mxCell id="phase1_band" value="① Browser composes the current 3-panel view into a PNG (canvas, no server roundtrip)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef3f8;strokeColor=#aac4e0;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="30" y="180" width="1450" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="note1" value="composeTriPanelBlob(linker): for each registered panel (rgb / recon / score) draw the live &amp;lt;img&amp;gt; into a tile of an offscreen canvas using its current getBoundingClientRect — captures the linked panzoom transform exactly as displayed. Same-origin imgs (served by nginx) so the canvas isn't tainted. toBlob(image/png)." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="80" y="215" width="900" height="65" as="geometry"/>
                </mxCell>

                <!-- Phase 2: POST -->
                <mxCell id="phase2_band" value="② POST /projects/{project_id}/visualizations — multipart" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2e0;strokeColor=#e0b070;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="30" y="295" width="1450" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="msg2_1" value="POST /api/projects/project_&amp;lt;uuid&amp;gt;/visualizations&lt;br/&gt;Content-Type: multipart/form-data&lt;br/&gt;image=&amp;lt;png blob&amp;gt;, meta=JSON{source:{kind, action_id|scene_id}, name, description?, view_state}&lt;br/&gt;Cookie: allotrope_jwt" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="200" y="365" as="sourcePoint"/><mxPoint x="590" y="365" as="targetPoint"/></mxGeometry>
                </mxCell>

                <!-- Phase 3: validate -->
                <mxCell id="phase3_band" value="③ Validate auth, project, source scope" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6f3e6;strokeColor=#82b366;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="30" y="390" width="1450" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="note3" value="current_user_claims (JWT, no DB).&lt;br/&gt;db.get(Project) → 404 project_not_found.&lt;br/&gt;image.content_type ∈ {image/png, image/jpeg} else 415 unsupported_image_type.&lt;br/&gt;source.kind == 'scene' → scene_uuid MUST equal project.scene_id (422 scene_not_in_project).&lt;br/&gt;source.kind == 'action_output' → look up unique ActionOutput by action_id, verify its artifact_path starts with projects/&amp;lt;pid&amp;gt;/actions/ (422 action_not_in_project)." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="240" y="425" width="800" height="90" as="geometry"/>
                </mxCell>

                <!-- Phase 4: write file -->
                <mxCell id="phase4_band" value="④ Stream image to disk under projects/&lt;pid&gt;/visualizations/&lt;vid&gt;/" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3e6f3;strokeColor=#a874a8;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="30" y="525" width="1450" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="msg4_1" value="mkdir -p projects/&amp;lt;pid&amp;gt;/visualizations/&amp;lt;vid&amp;gt;/&lt;br/&gt;write image.png in 64 KiB chunks (cap 25 MB → 413 image_too_large; rollback dir)" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="590" y="585" as="sourcePoint"/><mxPoint x="930" y="585" as="targetPoint"/></mxGeometry>
                </mxCell>

                <!-- Phase 5: INSERT -->
                <mxCell id="phase5_band" value="⑤ INSERT Visualization row (source_kind XOR CHECK enforces polymorphism)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8e0e0;strokeColor=#b85450;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="30" y="615" width="1450" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="msg5_1" value="INSERT INTO visualizations (id, project_id, source_kind, source_scene_id|source_action_output_id,&lt;br/&gt;name, description, artifact_path, view_state) VALUES (...);&lt;br/&gt;COMMIT — on failure: rmtree the directory we just wrote (no orphan files)" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="590" y="685" as="sourcePoint"/><mxPoint x="1260" y="685" as="targetPoint"/></mxGeometry>
                </mxCell>

                <!-- Phase 6: response -->
                <mxCell id="phase6_band" value="⑥ 201 Created — VisualizationPublic" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef3f8;strokeColor=#aac4e0;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="30" y="715" width="1450" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="msg6_1" value="201 Created&lt;br/&gt;{ id: viz_&amp;lt;uuid&amp;gt;, project_id, source_kind, source_scene_id?, source_action_output_id?,&lt;br/&gt;name, description, artifact_path, image_url: /visualizations/&amp;lt;id&amp;gt;/image, view_state, created_at, updated_at }" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;startArrow=classic;startFill=1;dashed=1;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="590" y="785" as="sourcePoint"/><mxPoint x="200" y="785" as="targetPoint"/></mxGeometry>
                </mxCell>
                <mxCell id="note6" value="Browser dispatches window CustomEvent 'allotrope:viz-saved'. VisualizationsPane subscribes and re-fetches GET /projects/{id}/visualizations — new row appears without a page reload." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="80" y="810" width="900" height="45" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>
