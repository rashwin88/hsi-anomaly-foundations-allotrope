<mxfile host="65bd71144e">
    <diagram id="scenes_list" name="GET /scenes">
        <mxGraphModel dx="1502" dy="931" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="980" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="GET /scenes — implementation sequence" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="40" y="20" width="800" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="subtitle" value="The Library list endpoint. Auth via claims (no DB read). Two queries: count + page. Library is shared (CC-3) — any authenticated user can list." style="text;html=1;fontSize=12;fontStyle=2;fontColor=#666666;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="40" y="52" width="1300" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="actor_browser" value="Browser (Client)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="120" y="85" width="160" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="actor_api" value="api (FastAPI)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="520" y="85" width="160" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="actor_pg" value="postgres" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="920" y="85" width="160" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="ll_browser" style="endArrow=none;dashed=1;html=1;rounded=0;strokeColor=#999999;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="200" y="125" as="sourcePoint"/>
                        <mxPoint x="200" y="920" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="ll_api" style="endArrow=none;dashed=1;html=1;rounded=0;strokeColor=#999999;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="600" y="125" as="sourcePoint"/>
                        <mxPoint x="600" y="920" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="ll_pg" style="endArrow=none;dashed=1;html=1;rounded=0;strokeColor=#999999;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="1000" y="125" as="sourcePoint"/>
                        <mxPoint x="1000" y="920" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="phase1_band" value="① Request" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef3f8;strokeColor=#aac4e0;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="30" y="140" width="1340" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="msg1_1" value="GET /scenes?limit=50&amp;offset=0&amp;sensor_type=prisma&lt;br/&gt;Cookie: allotrope_jwt=&amp;lt;jwt&amp;gt; (auto-attached)" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="200" y="200" as="sourcePoint"/>
                        <mxPoint x="600" y="200" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="phase2_band" value="② Auth dependency: current_user_claims (deps.py) — local crypto, no I/O" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2e0;strokeColor=#e0b070;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="30" y="240" width="1340" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="note2" value="FastAPI resolves Depends(current_user_claims):&lt;br/&gt;1. Read Cookie(allotrope_jwt)&lt;br/&gt;2. decode_token(token) — verify HS256 signature, check exp &amp;gt; now&lt;br/&gt;3. Return claims dict { sub, iat, exp, username, is_admin }&lt;br/&gt;&lt;b&gt;No DB read for auth.&lt;/b&gt; Library is shared (CC-3); no admin gate." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="320" y="280" width="640" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="branch_label_a" value="&lt;b&gt;Failure branches (handler never runs):&lt;/b&gt;" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontColor=#444;" parent="1" vertex="1">
                    <mxGeometry x="40" y="395" width="400" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="branch_a1" value="no/bad cookie → HTTP 401 { detail: &amp;quot;unauthenticated&amp;quot; }" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#cccccc;align=left;verticalAlign=middle;fontStyle=0;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="80" y="425" width="640" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="branch_a2" value="exp ≤ now → HTTP 401 { detail: &amp;quot;session_expired&amp;quot; }" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#cccccc;align=left;verticalAlign=middle;fontStyle=0;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="80" y="460" width="640" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="phase3_band" value="③ Count query — total rows matching the filter" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f1e6;strokeColor=#a8c8a4;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="30" y="510" width="1340" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="msg3_1" value="SELECT COUNT(*) FROM scenes WHERE sensor_type = $1   (filter optional)" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="600" y="570" as="sourcePoint"/>
                        <mxPoint x="1000" y="570" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="msg3_2" value="total: integer" style="endArrow=open;html=1;edgeStyle=none;dashed=1;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="1000" y="605" as="sourcePoint"/>
                        <mxPoint x="600" y="605" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="phase4_band" value="④ Page query — order by recency, slice limit/offset" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5eef8;strokeColor=#c8a4d0;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="30" y="635" width="1340" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="msg4_1" value="SELECT * FROM scenes [WHERE sensor_type = $1] ORDER BY created_at DESC LIMIT $2 OFFSET $3" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="600" y="695" as="sourcePoint"/>
                        <mxPoint x="1000" y="695" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="msg4_2" value="rows[]" style="endArrow=open;html=1;edgeStyle=none;dashed=1;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="1000" y="730" as="sourcePoint"/>
                        <mxPoint x="600" y="730" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="note4" value="Indexes earning their keep:&lt;br/&gt;· scenes_created_at_idx — backs ORDER BY created_at DESC&lt;br/&gt;· scenes_sensor_type_idx — narrows the set when sensor_type is given&lt;br/&gt;· scenes_has_annotations_idx — for the future has_annotations facet" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="200" y="755" width="640" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="phase5_band" value="⑤ Project rows → ScenePublic and respond" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#aaaaaa;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="30" y="845" width="1340" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="msg5_1" value="HTTP 200&lt;br/&gt;{ items: [{ id: scene_&amp;lt;uuid&amp;gt;, sensor_type, …, metadata, created_by_user_id: user_&amp;lt;uuid&amp;gt;|null, … }, …], total, limit, offset }" style="endArrow=open;html=1;edgeStyle=none;dashed=1;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="600" y="900" as="sourcePoint"/>
                        <mxPoint x="200" y="900" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="footer" value="Two queries (count + page) is the simplest accurate pagination — gives the client a real `total` so it can render &amp;quot;page X of Y&amp;quot;. We&apos;ll graduate to keyset/cursor pagination if the table grows large enough that the OFFSET path becomes slow. ScenePublic projects: id → scene_&amp;lt;uuid&amp;gt;, NUMERIC → float, the model&apos;s `extra_metadata` field → `metadata` in the JSON response." style="text;html=1;fontSize=11;fontStyle=2;fontColor=#666666;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="80" y="930" width="1240" height="40" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>
