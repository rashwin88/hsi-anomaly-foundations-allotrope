<mxfile host="65bd71144e">
    <diagram id="project_export" name="project export (Step 17)">
        <mxGraphModel dx="1502" dy="931" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1080" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="Project export — async bundle assembly, Option B" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="40" y="20" width="1200" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="subtitle" value="POST /projects/{id}/exports enqueues a project_export Job and returns the job id — the Export row does NOT exist yet. Worker dispatches, opens the zip, snapshots Result + every Action's output tree + every Visualization + every Note + scene thumbnail, sizes the bundle, INSERTs Export only after the zip closes cleanly. ResultPanelPane polls /jobs/{id} until the job settles, then re-fetches /projects/{id}/exports to surface the new bundle row." style="text;html=1;fontSize=12;fontStyle=2;fontColor=#666666;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="40" y="52" width="1400" height="70" as="geometry"/>
                </mxCell>

                <!-- Actors -->
                <mxCell id="actor_browser" value="Browser (ResultPanelPane)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="60" y="135" width="240" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="actor_api" value="api (FastAPI)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="420" y="135" width="160" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="actor_pg" value="postgres" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="720" y="135" width="160" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="actor_worker" value="worker (project_export)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="980" y="135" width="220" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="actor_data" value="allotrope_artifacts (volume)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8d5e8;strokeColor=#a874a8;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="1260" y="135" width="220" height="40" as="geometry"/>
                </mxCell>

                <!-- Lifelines -->
                <mxCell id="ll_browser" style="endArrow=none;dashed=1;html=1;rounded=0;strokeColor=#999999;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="180" y="175" as="sourcePoint"/><mxPoint x="180" y="1040" as="targetPoint"/></mxGeometry>
                </mxCell>
                <mxCell id="ll_api" style="endArrow=none;dashed=1;html=1;rounded=0;strokeColor=#999999;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="500" y="175" as="sourcePoint"/><mxPoint x="500" y="1040" as="targetPoint"/></mxGeometry>
                </mxCell>
                <mxCell id="ll_pg" style="endArrow=none;dashed=1;html=1;rounded=0;strokeColor=#999999;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="800" y="175" as="sourcePoint"/><mxPoint x="800" y="1040" as="targetPoint"/></mxGeometry>
                </mxCell>
                <mxCell id="ll_worker" style="endArrow=none;dashed=1;html=1;rounded=0;strokeColor=#999999;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="1090" y="175" as="sourcePoint"/><mxPoint x="1090" y="1040" as="targetPoint"/></mxGeometry>
                </mxCell>
                <mxCell id="ll_data" style="endArrow=none;dashed=1;html=1;rounded=0;strokeColor=#999999;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="1370" y="175" as="sourcePoint"/><mxPoint x="1370" y="1040" as="targetPoint"/></mxGeometry>
                </mxCell>

                <!-- Phase 1 -->
                <mxCell id="phase1" value="① POST /projects/{project_id}/exports — enqueue project_export Job" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef3f8;strokeColor=#aac4e0;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="30" y="200" width="1450" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="msg1_1" value="POST /api/projects/project_&amp;lt;uuid&amp;gt;/exports&lt;br/&gt;Cookie: allotrope_jwt" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="180" y="260" as="sourcePoint"/><mxPoint x="500" y="260" as="targetPoint"/></mxGeometry>
                </mxCell>
                <mxCell id="note1" value="api guards against double-fire: SELECT FROM jobs WHERE type='project_export' AND project_id=? AND status IN ('queued','running') — return 409 export_already_running if a bundle is already in flight." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="180" y="290" width="800" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="msg1_2" value="INSERT INTO jobs (type='project_export', status='queued', project_id, target_kind='export', payload={project_id});&lt;br/&gt;COMMIT" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="500" y="370" as="sourcePoint"/><mxPoint x="800" y="370" as="targetPoint"/></mxGeometry>
                </mxCell>
                <mxCell id="msg1_3" value="202 Accepted&lt;br/&gt;{ job_id: job_&amp;lt;uuid&amp;gt;, project_id }" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;startArrow=classic;startFill=1;dashed=1;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="500" y="410" as="sourcePoint"/><mxPoint x="180" y="410" as="targetPoint"/></mxGeometry>
                </mxCell>

                <!-- Phase 2 -->
                <mxCell id="phase2" value="② Worker claims the job (FOR UPDATE SKIP LOCKED) and starts assembling" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2e0;strokeColor=#e0b070;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="30" y="445" width="1450" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="msg2_1" value="UPDATE jobs SET status='running', started_at=now() WHERE id=...; COMMIT" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;startArrow=classic;startFill=1;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="800" y="505" as="sourcePoint"/><mxPoint x="1090" y="505" as="targetPoint"/></mxGeometry>
                </mxCell>
                <mxCell id="note2" value="Reads (one tx): Project + Scene + all Actions + ActionOutputs + Visualizations + Notes + NoteReferences + Annotations. Read-only until the zip closes — coherent snapshot." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="200" y="535" width="780" height="55" as="geometry"/>
                </mxCell>

                <!-- Phase 3 -->
                <mxCell id="phase3" value="③ Build zip — manifest.json + result.json + scene/ + actions/ + visualizations/ + notes/ + annotations/" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3e6f3;strokeColor=#a874a8;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="30" y="600" width="1450" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="msg3" value="mkdir projects/&amp;lt;pid&amp;gt;/exports/&amp;lt;eid&amp;gt;/&lt;br/&gt;open zipfile (ZIP_DEFLATED level=6)&lt;br/&gt;walk action_outputs.artifact_path, visualizations.artifact_path,&lt;br/&gt;annotations.raster_path → copy into the zip with stable arc names&lt;br/&gt;Any exception → rmtree the partial dir; no Export row written" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="1090" y="700" as="sourcePoint"/><mxPoint x="1370" y="700" as="targetPoint"/></mxGeometry>
                </mxCell>

                <!-- Phase 4 -->
                <mxCell id="phase4" value="④ Insert Export row (Option B) + mark Job complete" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6f3e6;strokeColor=#82b366;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="30" y="745" width="1450" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="msg4" value="INSERT INTO exports (id, project_id, bundle_path, snapshot_at, size_bytes, format='zip');&lt;br/&gt;UPDATE jobs SET status='complete', target_id=export.id, completed_at=now();&lt;br/&gt;COMMIT — Export row exists only after the zip is sized." style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="1090" y="820" as="sourcePoint"/><mxPoint x="800" y="820" as="targetPoint"/></mxGeometry>
                </mxCell>

                <!-- Phase 5 -->
                <mxCell id="phase5" value="⑤ Browser polls /jobs/{id} → settles → re-fetches /projects/{id}/exports" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef3f8;strokeColor=#aac4e0;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="30" y="855" width="1450" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="msg5_1" value="GET /api/jobs/job_&amp;lt;uuid&amp;gt; (every 2 s) → status=complete; target_id=export_&amp;lt;uuid&amp;gt;" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="180" y="915" as="sourcePoint"/><mxPoint x="500" y="915" as="targetPoint"/></mxGeometry>
                </mxCell>
                <mxCell id="msg5_2" value="GET /api/projects/&amp;lt;pid&amp;gt;/exports → list with new ExportPublic at the top.&lt;br/&gt;Download link points at /api/exports/&amp;lt;eid&amp;gt;/download (Cache-Control: immutable)." style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="180" y="975" as="sourcePoint"/><mxPoint x="500" y="975" as="targetPoint"/></mxGeometry>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
