<mxfile host="65bd71144e">
    <diagram id="scene_detail" name="GET /scenes/{id} + thumbnail">
        <mxGraphModel dx="1502" dy="931" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="GET /scenes/{id} — Scene Detail page" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="40" y="20" width="900" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="subtitle" value="The detail click-through from the Library table. Two parallel reads: scene metadata (JSON) + thumbnail (PNG). Auth via claims (no DB read for auth)." style="text;html=1;fontSize=12;fontStyle=2;fontColor=#666666;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="40" y="52" width="1300" height="20" as="geometry"/>
