<mxfile host="65bd71144e">
    <diagram id="project_workspace_load" name="Project workspace load">
        <mxGraphModel dx="1502" dy="931" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="780" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>

                <mxCell id="title" value="Project workspace load — GET /projects/{id} (with child counts) + GET /scenes/{scene_id} in parallel" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="40" y="20" width="1320" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="subtitle" value="The workspace shell needs Project + Scene metadata + child counts to render the header bar, scene-context pane, and Action / Viz / Notes empty states. Frontend kicks off both fetches in parallel from ProjectWorkspacePage&apos;s mount effect." style="text;html=1;fontSize=12;fontStyle=2;fontColor=#666666;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="40" y="52" width="1320" height="20" as="geometry"/>
                </mxCell>

                <mxCell id="actor_browser" value="Browser (ProjectWorkspacePage)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="80" y="85" width="240" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="actor_api" value="api (FastAPI)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="540" y="85" width="160" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="actor_pg" value="postgres (projects ⨝ scenes)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="900" y="85" width="220" height="40" as="geometry"/>
                </mxCell>

                <mxCell id="ll_browser" style="endArrow=none;dashed=1;html=1;rounded=0;strokeColor=#999999;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="200" y="125" as="sourcePoint"/><mxPoint x="200" y="720" as="targetPoint"/></mxGeometry>
                </mxCell>
                <mxCell id="ll_api" style="endArrow=none;dashed=1;html=1;rounded=0;strokeColor=#999999;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="620" y="125" as="sourcePoint"/><mxPoint x="620" y="720" as="targetPoint"/></mxGeometry>
                </mxCell>
                <mxCell id="ll_pg" style="endArrow=none;dashed=1;html=1;rounded=0;strokeColor=#999999;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="1010" y="125" as="sourcePoint"/><mxPoint x="1010" y="720" as="targetPoint"/></mxGeometry>
                </mxCell>

                <mxCell id="phase1_band" value="① Mount: kick off project + scene fetches in parallel" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef3f8;strokeColor=#aac4e0;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="30" y="150" width="1340" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="msg1a" value="GET /api/projects/project_&amp;lt;uuid&amp;gt;&lt;br/&gt;Cookie: allotrope_jwt" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="200" y="210" as="sourcePoint"/><mxPoint x="620" y="210" as="targetPoint"/></mxGeometry>
                </mxCell>
                <mxCell id="msg1b" value="GET /api/scenes/scene_&amp;lt;uuid&amp;gt;  (issued in parallel with msg1a)" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;dashed=1;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="200" y="245" as="sourcePoint"/><mxPoint x="620" y="245" as="targetPoint"/></mxGeometry>
                </mxCell>

                <mxCell id="phase2_band" value="② Auth + parse project_id" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2e0;strokeColor=#e0b070;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="30" y="270" width="1340" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="msg2" value="current_user_claims (401 if cookie missing/invalid) → parse_prefixed_id(&quot;project&quot;, …) (422 bad_id_format)" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontStyle=2;fontColor=#444444;" parent="1" vertex="1">
                    <mxGeometry x="220" y="305" width="700" height="20" as="geometry"/>
                </mxCell>

                <mxCell id="phase3_band" value="③ Read project + scene (one transaction)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0e0f0;strokeColor=#b070b0;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="30" y="335" width="1340" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="msg3" value="db.get(Project, project_uuid)  →  404 project_not_found if absent" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="620" y="380" as="sourcePoint"/><mxPoint x="1010" y="380" as="targetPoint"/></mxGeometry>
                </mxCell>
                <mxCell id="msg4" value="db.get(Scene, project.scene_id)  (RESTRICT FK guarantees presence; 500 scene_missing_for_project guards anyway)" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="620" y="420" as="sourcePoint"/><mxPoint x="1010" y="420" as="targetPoint"/></mxGeometry>
                </mxCell>
                <mxCell id="msg5" value="Project ORM + Scene ORM rows" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;dashed=1;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="1010" y="460" as="sourcePoint"/><mxPoint x="620" y="460" as="targetPoint"/></mxGeometry>
                </mxCell>

                <mxCell id="phase4_band" value="④ Compose ProjectDetail (Project + Scene + child counts)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fbe5d6;strokeColor=#d99458;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="30" y="490" width="1340" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="msg6" value="ProjectDetail = ProjectPublic { id, user_id, scene_id, name, description, created_at, updated_at, scene_name, scene_sensor_type } + { action_count, visualization_count, note_count }" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontStyle=2;fontColor=#444444;" parent="1" vertex="1">
                    <mxGeometry x="220" y="525" width="1100" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="msg6b" value="Step 11: action_count / visualization_count / note_count = 0 (source tables don&apos;t exist yet). Each is swapped to live SELECT count(*) when its table lands in Step 12+." style="text;html=1;fontSize=10;align=left;verticalAlign=middle;fontStyle=2;fontColor=#888888;" parent="1" vertex="1">
                    <mxGeometry x="220" y="545" width="900" height="20" as="geometry"/>
                </mxCell>

                <mxCell id="phase5_band" value="⑤ Response" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="30" y="575" width="1340" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="msg7" value="200 — ProjectDetail   (msg1a response)" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="620" y="620" as="sourcePoint"/><mxPoint x="200" y="620" as="targetPoint"/></mxGeometry>
                </mxCell>
                <mxCell id="msg7b" value="200 — ScenePublic     (msg1b response, completes independently)" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;dashed=1;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="620" y="655" as="sourcePoint"/><mxPoint x="200" y="655" as="targetPoint"/></mxGeometry>
                </mxCell>

                <mxCell id="note" value="Errors:&lt;br/&gt;• 401 unauthenticated → frontend redirects to /login.&lt;br/&gt;• 404 project_not_found OR 404 scene_not_found → ProjectWorkspacePage shows a structural error card with &quot;← All projects&quot;.&lt;br/&gt;• 422 bad_id_format → same error card.&lt;br/&gt;• Scene fetch is duplicative (Project already carries scene_name + scene_sensor_type) but pulls full bbox / thumbnail / captured_at the workspace shell needs.&lt;br/&gt;• If scene has captured_at NULL or thumbnail_path NULL, the scene-context pane gracefully degrades (no thumbnail, no date)." style="text;html=1;fontSize=10;align=left;verticalAlign=top;fillColor=#fafafa;strokeColor=#cccccc;fontColor=#444444;" parent="1" vertex="1">
                    <mxGeometry x="40" y="685" width="1320" height="80" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>
