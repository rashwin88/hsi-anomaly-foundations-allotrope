<mxfile host="65bd71144e">
    <diagram id="scene_visualizations" name="Scene visualizations">
        <mxGraphModel dx="1502" dy="931" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1340" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="Scene visualizations — pre-rendered PNGs + interactive charts" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="40" y="20" width="1200" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="subtitle" value="Worker writes a fixed visualization set at onboard time. The api serves them four ways: list, image (PNG stream), histogram (JSON), spectrum (JSON, requires unpickled vendable cache)." style="text;html=1;fontSize=12;fontStyle=2;fontColor=#666666;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="40" y="52" width="1400" height="20" as="geometry"/>
                </mxCell>

                <!-- Actors -->
                <mxCell id="actor_browser" value="Browser (SceneVisualizations)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="80" y="85" width="220" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="actor_api" value="api (FastAPI)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="430" y="85" width="160" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="actor_pg" value="postgres (scenes)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="700" y="85" width="160" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="actor_artifacts" value="allotrope_artifacts (volume)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8d5e8;strokeColor=#a874a8;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="970" y="85" width="220" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="actor_cache" value="api process — vendable LRU cache" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="1230" y="85" width="220" height="40" as="geometry"/>
                </mxCell>

                <!-- Lifelines -->
                <mxCell id="ll_browser" style="endArrow=none;dashed=1;html=1;rounded=0;strokeColor=#999999;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="190" y="125" as="sourcePoint"/><mxPoint x="190" y="1290" as="targetPoint"/></mxGeometry>
                </mxCell>
                <mxCell id="ll_api" style="endArrow=none;dashed=1;html=1;rounded=0;strokeColor=#999999;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="510" y="125" as="sourcePoint"/><mxPoint x="510" y="1290" as="targetPoint"/></mxGeometry>
                </mxCell>
                <mxCell id="ll_pg" style="endArrow=none;dashed=1;html=1;rounded=0;strokeColor=#999999;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="780" y="125" as="sourcePoint"/><mxPoint x="780" y="1290" as="targetPoint"/></mxGeometry>
                </mxCell>
                <mxCell id="ll_art" style="endArrow=none;dashed=1;html=1;rounded=0;strokeColor=#999999;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="1080" y="125" as="sourcePoint"/><mxPoint x="1080" y="1290" as="targetPoint"/></mxGeometry>
                </mxCell>
                <mxCell id="ll_cache" style="endArrow=none;dashed=1;html=1;rounded=0;strokeColor=#999999;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="1340" y="125" as="sourcePoint"/><mxPoint x="1340" y="1290" as="targetPoint"/></mxGeometry>
                </mxCell>

                <!-- Pre-render preface -->
                <mxCell id="phase0_band" value="⓪ Onboarding pre-render — see scene-onboard.drawio" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#aaaaaa;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="30" y="140" width="1440" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="note0" value="At onboard time the worker calls allotrope_worker.visualizations.render_all(vendable, sensor_type, …) and writes:&lt;br/&gt;  • color.png         — true-colour RGB (hyperspectral) or inferno-mapped thermal&lt;br/&gt;  • nir.png / swir.png / ndvi.png  — hyperspectral composites&lt;br/&gt;  • band_mosaic.png   — every band as a tile&lt;br/&gt;  • histogram.json    — bins + counts + stats (uplot-ready)&lt;br/&gt;Scene.thumbnail_path → color.png so the Library table picks up the colour version with no api change." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="120" y="180" width="1280" height="100" as="geometry"/>
                </mxCell>

                <!-- Phase 1: list -->
                <mxCell id="phase1_band" value="① List visualizations — GET /scenes/{id}/visualizations" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef3f8;strokeColor=#aac4e0;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="30" y="300" width="1440" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="msg1_1" value="GET /api/scenes/&amp;lt;id&amp;gt;/visualizations" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="190" y="365" as="sourcePoint"/><mxPoint x="510" y="365" as="targetPoint"/></mxGeometry>
                </mxCell>
                <mxCell id="msg1_2" value="db.get(Scene, raw_id)" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="510" y="395" as="sourcePoint"/><mxPoint x="780" y="395" as="targetPoint"/></mxGeometry>
                </mxCell>
                <mxCell id="msg1_3" value="for kind in PNG_KINDS: viz_dir / &quot;&amp;lt;kind&amp;gt;.png&quot;.is_file()&lt;br/&gt;histogram.json present?" style="endArrow=classic;html=1;edgeStyle=none;dashed=1;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="510" y="430" as="sourcePoint"/><mxPoint x="1080" y="430" as="targetPoint"/></mxGeometry>
                </mxCell>
                <mxCell id="msg1_4" value="HTTP 200 { items: [{kind, label, image_url}, …], histogram_url }" style="endArrow=open;html=1;edgeStyle=none;dashed=1;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="510" y="465" as="sourcePoint"/><mxPoint x="190" y="465" as="targetPoint"/></mxGeometry>
                </mxCell>

                <!-- Phase 2: image -->
                <mxCell id="phase2_band" value="② Image — GET /scenes/{id}/visualizations/{kind}/image" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2e0;strokeColor=#e0b070;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="30" y="495" width="1440" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="msg2_1" value="&amp;lt;img src=&quot;/api/scenes/&amp;lt;id&amp;gt;/visualizations/&amp;lt;kind&amp;gt;/image&quot;&amp;gt;" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="190" y="555" as="sourcePoint"/><mxPoint x="510" y="555" as="targetPoint"/></mxGeometry>
                </mxCell>
                <mxCell id="msg2_2" value="kind ∈ PNG_KINDS? else 404 unknown_kind" style="endArrow=classic;html=1;edgeStyle=none;dashed=1;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="510" y="585" as="sourcePoint"/><mxPoint x="510" y="610" as="targetPoint"/></mxGeometry>
                </mxCell>
                <mxCell id="msg2_3" value="db.get(Scene)  + path-traversal guard (resolve / relative_to artifacts root)" style="endArrow=classic;html=1;edgeStyle=none;fontSize=10;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="510" y="620" as="sourcePoint"/><mxPoint x="780" y="620" as="targetPoint"/></mxGeometry>
                </mxCell>
                <mxCell id="msg2_4" value="open scenes/&amp;lt;id&amp;gt;/visualizations/&amp;lt;kind&amp;gt;.png" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="510" y="655" as="sourcePoint"/><mxPoint x="1080" y="655" as="targetPoint"/></mxGeometry>
                </mxCell>
                <mxCell id="msg2_5" value="HTTP 200 image/png — Cache-Control: public, max-age=31536000, immutable" style="endArrow=open;html=1;edgeStyle=none;dashed=1;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="510" y="690" as="sourcePoint"/><mxPoint x="190" y="690" as="targetPoint"/></mxGeometry>
                </mxCell>

                <!-- Phase 3: histogram -->
                <mxCell id="phase3_band" value="③ Histogram — GET /scenes/{id}/histogram (JSON, rendered with uplot)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f1e6;strokeColor=#a8c8a4;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="30" y="720" width="1440" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="msg3_1" value="GET /api/scenes/&amp;lt;id&amp;gt;/histogram" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="190" y="780" as="sourcePoint"/><mxPoint x="510" y="780" as="targetPoint"/></mxGeometry>
                </mxCell>
                <mxCell id="msg3_2" value="read scenes/&amp;lt;id&amp;gt;/visualizations/histogram.json" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="510" y="815" as="sourcePoint"/><mxPoint x="1080" y="815" as="targetPoint"/></mxGeometry>
                </mxCell>
                <mxCell id="msg3_3" value="HTTP 200 { sensor_type, kind, bins[N+1], counts[N], stats{mean,std,min,max,p2,p50,p98,valid_pct} }" style="endArrow=open;html=1;edgeStyle=none;dashed=1;fontSize=10;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="510" y="850" as="sourcePoint"/><mxPoint x="190" y="850" as="targetPoint"/></mxGeometry>
                </mxCell>

                <!-- Phase 4: spectrum -->
                <mxCell id="phase4_band" value="④ Spectrum (interactive) — GET /scenes/{id}/spectrum?row=&amp;col=" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5eef8;strokeColor=#c8a4d0;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="30" y="880" width="1440" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="note4_a" value="Triggered by clicking the colour image. Hyperspectral only; thermal scenes get 422 unsupported_sensor.&lt;br/&gt;The frontend maps display-pixel coords → scene-resolution row/col using the response's height/width on first call (one auto-refetch if the initial guess drifts &amp;gt;5%)." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="120" y="920" width="900" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="msg4_1" value="GET /api/scenes/&amp;lt;id&amp;gt;/spectrum?row=R&amp;col=C" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="190" y="1000" as="sourcePoint"/><mxPoint x="510" y="1000" as="targetPoint"/></mxGeometry>
                </mxCell>
                <mxCell id="msg4_2" value="db.get(Scene). reject 422 if sensor_type='landsat9'" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="510" y="1030" as="sourcePoint"/><mxPoint x="780" y="1030" as="targetPoint"/></mxGeometry>
                </mxCell>
                <mxCell id="msg4_3" value="lookup vendable in process LRU cache (size=2)" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="510" y="1065" as="sourcePoint"/><mxPoint x="1340" y="1065" as="targetPoint"/></mxGeometry>
                </mxCell>
                <mxCell id="branch4" value="If MISS: open vendable.pkl, pickle.load(), store in LRU (~2 s for PRISMA, evicts oldest if &amp;gt; size).&lt;br/&gt;If HIT: skip the read entirely (~30 ms total round-trip)." style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontColor=#444;fontStyle=2;" parent="1" vertex="1">
                    <mxGeometry x="540" y="1085" width="800" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="msg4_4" value="open scenes/&amp;lt;id&amp;gt;/vendable/vendable.pkl  (allotrope_data, miss only)" style="endArrow=classic;html=1;edgeStyle=none;dashed=1;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="1340" y="1135" as="sourcePoint"/><mxPoint x="1080" y="1135" as="targetPoint"/></mxGeometry>
                </mxCell>
                <mxCell id="msg4_5" value="cube[:, row, col] + band_cw_order[]  →  build SpectrumPoint[]" style="endArrow=classic;html=1;edgeStyle=none;dashed=1;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="510" y="1170" as="sourcePoint"/><mxPoint x="510" y="1195" as="targetPoint"/></mxGeometry>
                </mxCell>
                <mxCell id="msg4_6" value="HTTP 200 { row, col, height, width, points: [{wavelength_nm, reflectance, spectral_family, is_valid}, …] }" style="endArrow=open;html=1;edgeStyle=none;dashed=1;fontSize=10;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="510" y="1220" as="sourcePoint"/><mxPoint x="190" y="1220" as="targetPoint"/></mxGeometry>
                </mxCell>

                <!-- Phase 5: bands -->
                <mxCell id="phase5_band" value="⑤ Band browser (interactive) — GET /scenes/{id}/bands  +  /bands/{idx}/image" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fbe5e5;strokeColor=#d09898;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="30" y="1245" width="1440" height="26" as="geometry"/>
                </mxCell>
                <!-- (Lifelines extend to 1380; phase 5 sits at the very bottom band of the same diagram.) -->
                <mxCell id="footer" value="Frontend sorts spectrum ascending by wavelength before plotting (PRISMA orders SWIR before VNIR). uplot is dynamically imported. Bandwidth: list ~1 KB, image ~250 KB, histogram ~2 KB, spectrum ~25 KB. Cache headers on PNGs mean repeat tile clicks don't re-fetch.&#10;PHASE ⑤ — Bands mode reads /bands (list of {index, λ, family, valid}) and renders the active band on demand via /bands/{idx}/image (vendable cache hit ~270 ms; cold first call ~3 s while pickle loads). PNGs cached aggressively per immutable pickle.&#10;PRISMA: 239 bands. Landsat: 422 unsupported_sensor (single-band thermal). Out-of-range index: 422 band_out_of_range. Scene not found: 404 scene_not_found. Vendable missing on disk: 404 vendable_unavailable." style="text;html=1;fontSize=11;fontStyle=2;fontColor=#666666;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1280" width="1430" height="60" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>
