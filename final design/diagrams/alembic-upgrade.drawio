<mxfile host="65bd71144e">
    <diagram id="alembic_upgrade" name="alembic upgrade head">
        <mxGraphModel dx="1502" dy="931" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1250" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="alembic upgrade head — internals" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="40" y="20" width="700" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="subtitle" value="What `docker compose run --rm api alembic upgrade head` actually does. The alembic_version table is the bookkeeping; one row, one column (`version_num`)." style="text;html=1;fontSize=12;fontStyle=2;fontColor=#666666;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="40" y="52" width="1300" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="actor_you" value="you (terminal)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="120" y="85" width="160" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="actor_docker" value="docker engine" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="480" y="85" width="160" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="actor_alembic" value="alembic process (in api container)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="820" y="85" width="200" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="actor_pg" value="postgres" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="1200" y="85" width="160" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="ll_you" style="endArrow=none;dashed=1;html=1;rounded=0;strokeColor=#999999;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="200" y="125" as="sourcePoint"/>
                        <mxPoint x="200" y="1190" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="ll_docker" style="endArrow=none;dashed=1;html=1;rounded=0;strokeColor=#999999;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="560" y="125" as="sourcePoint"/>
                        <mxPoint x="560" y="1190" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="ll_alembic" style="endArrow=none;dashed=1;html=1;rounded=0;strokeColor=#999999;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="920" y="125" as="sourcePoint"/>
                        <mxPoint x="920" y="1190" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="ll_pg" style="endArrow=none;dashed=1;html=1;rounded=0;strokeColor=#999999;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="1280" y="125" as="sourcePoint"/>
                        <mxPoint x="1280" y="1190" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="phase1_band" value="① Bootstrap — load config + env.py" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef3f8;strokeColor=#aac4e0;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="30" y="140" width="1430" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="msg1_1" value="docker compose run --rm api alembic upgrade head" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="200" y="195" as="sourcePoint"/>
                        <mxPoint x="560" y="195" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="msg1_2" value="spawn one-shot container; CMD = alembic upgrade head" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="560" y="240" as="sourcePoint"/>
                        <mxPoint x="920" y="240" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="note1" value="alembic loads:&lt;br/&gt;· alembic.ini (logging config; placeholder DB URL ignored)&lt;br/&gt;· alembic/env.py — imports allotrope.config (settings) and allotrope.models (registers every model class on Base.metadata)&lt;br/&gt;· context.is_offline_mode() → False → run_migrations_online()" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="710" y="270" width="500" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="phase2_band" value="② Detect current state — read alembic_version" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2e0;strokeColor=#e0b070;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="30" y="400" width="1430" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="msg2_1" value="create_engine(settings.database_url).connect() — open TCP" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="920" y="455" as="sourcePoint"/>
                        <mxPoint x="1280" y="455" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="msg2_2" value="connection ok" style="endArrow=open;html=1;edgeStyle=none;dashed=1;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="1280" y="490" as="sourcePoint"/>
                        <mxPoint x="920" y="490" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="msg2_3" value="BEGIN  (transactional DDL — postgres supports it)" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="920" y="525" as="sourcePoint"/>
                        <mxPoint x="1280" y="525" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="msg2_4" value="CREATE TABLE IF NOT EXISTS alembic_version (version_num VARCHAR(32) PRIMARY KEY)" style="endArrow=classic;html=1;edgeStyle=none;fontSize=10;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="920" y="560" as="sourcePoint"/>
                        <mxPoint x="1280" y="560" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="msg2_5" value="SELECT version_num FROM alembic_version" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="920" y="595" as="sourcePoint"/>
                        <mxPoint x="1280" y="595" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="msg2_6" value="(empty — first run)  /  ['20260510_01']  on re-run" style="endArrow=open;html=1;edgeStyle=none;dashed=1;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="1280" y="630" as="sourcePoint"/>
                        <mxPoint x="920" y="630" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="phase3_band" value="③ Plan — walk the revision graph from current to head" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f1e6;strokeColor=#a8c8a4;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="30" y="660" width="1430" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="note3" value="alembic compares current → head and builds the chain of pending revisions:&lt;br/&gt;· current = None (or last applied)&lt;br/&gt;· head = 20260510_01 (latest revision in alembic/versions/)&lt;br/&gt;· pending = [20260510_01]&lt;br/&gt;If pending is empty → log &amp;quot;already at head&amp;quot;, COMMIT, exit. (Idempotent.)" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="220" y="700" width="640" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="phase4_band" value="④ Apply pending — run upgrade() for each (in order)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5eef8;strokeColor=#c8a4d0;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="30" y="820" width="1430" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="note4" value="alembic loads alembic/versions/20260510_01_create_users.py and runs upgrade() — every op.* call emits a SQL statement on the existing connection." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="220" y="857" width="640" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="msg4_1" value="CREATE TABLE users (id uuid PRIMARY KEY, username text NOT NULL, email text NOT NULL, password_hash text NOT NULL, display_name text, last_login_at timestamptz, is_admin boolean NOT NULL DEFAULT false, created_at timestamptz NOT NULL DEFAULT now(), updated_at timestamptz NOT NULL DEFAULT now())" style="endArrow=classic;html=1;edgeStyle=none;fontSize=9;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="920" y="930" as="sourcePoint"/>
                        <mxPoint x="1280" y="930" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="msg4_2" value="CREATE UNIQUE INDEX users_username_lower_uq ON users (lower(username))" style="endArrow=classic;html=1;edgeStyle=none;fontSize=10;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="920" y="970" as="sourcePoint"/>
                        <mxPoint x="1280" y="970" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="msg4_3" value="CREATE UNIQUE INDEX users_email_lower_uq ON users (lower(email))" style="endArrow=classic;html=1;edgeStyle=none;fontSize=10;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="920" y="1005" as="sourcePoint"/>
                        <mxPoint x="1280" y="1005" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="phase5_band" value="⑤ Record + commit — bookkeeping update, then COMMIT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#aaaaaa;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="30" y="1035" width="1430" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="msg5_1" value="INSERT INTO alembic_version (version_num) VALUES ('20260510_01')" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="920" y="1090" as="sourcePoint"/>
                        <mxPoint x="1280" y="1090" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="msg5_2" value="COMMIT" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="920" y="1125" as="sourcePoint"/>
                        <mxPoint x="1280" y="1125" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="msg5_3" value="stdout: Running upgrade  -&amp;gt; 20260510_01, create users table → exit 0" style="endArrow=open;html=1;edgeStyle=none;dashed=1;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="920" y="1160" as="sourcePoint"/>
                        <mxPoint x="200" y="1160" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="footer" value="The whole flow runs inside ONE transaction (BEGIN ... COMMIT). If any DDL fails, postgres rolls back — the alembic_version table is not updated, and the next run retries from the same starting point. This is why `op.create_table` and friends work transactionally on postgres but NOT on databases without transactional DDL (MySQL, older Oracle)." style="text;html=1;fontSize=11;fontStyle=2;fontColor=#666666;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="80" y="1200" width="1340" height="40" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>
