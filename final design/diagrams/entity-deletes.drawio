<mxfile host="65bd71144e">
    <diagram id="entity_deletes" name="entity deletes (scene · action · visualization)">
        <mxGraphModel dx="1502" dy="931" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1180" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="Entity deletes — synchronous DB delete + filesystem rmtree" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="40" y="20" width="1200" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="subtitle" value="Three independent flows share the same pattern: validate dependencies → DELETE row + COMMIT → rmtree on-disk dirs. Disk reclamation is the second half — without it the Monitoring page's disk_usage doesn't fall. rmtree is best-effort: any OSError is logged but does NOT fail the response, since the DB row (the source of truth) is already gone." style="text;html=1;fontSize=12;fontStyle=2;fontColor=#666666;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="40" y="52" width="1400" height="55" as="geometry"/>
                </mxCell>

                <!-- ============================================================ -->
                <!-- SECTION A: scene delete                                       -->
                <!-- ============================================================ -->
                <mxCell id="sec_a" value="A · DELETE /scenes/{id} — Library scene removal" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=middle;fontStyle=1;fontSize=13;" parent="1" vertex="1">
                    <mxGeometry x="30" y="120" width="1450" height="28" as="geometry"/>
                </mxCell>

                <mxCell id="a_browser" value="Browser (ScenesPage / SceneDetail)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="60" y="160" width="240" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="a_api" value="api" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="420" y="160" width="120" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="a_pg" value="postgres (RESTRICT projects → scenes)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="680" y="160" width="280" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="a_data" value="allotrope_data · /scenes/&lt;id&gt;/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8d5e8;strokeColor=#a874a8;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="1060" y="160" width="190" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="a_art" value="allotrope_artifacts · /scenes/&lt;id&gt;/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8d5e8;strokeColor=#a874a8;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="1270" y="160" width="200" height="36" as="geometry"/>
                </mxCell>

                <mxCell id="a_step1" value="① DELETE /scenes/scene_&amp;lt;uuid&amp;gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef3f8;strokeColor=#aac4e0;align=left;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="30" y="210" width="1450" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="a_step2" value="② RESTRICT check — SELECT id FROM projects WHERE scene_id=$1 — if any rows → 409 {code:&quot;scene_in_use&quot;, blocking_project_ids:[...]}" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2e0;strokeColor=#e0b070;align=left;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="30" y="240" width="1450" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="a_step3" value="③ DELETE FROM scenes WHERE id=$1; COMMIT — annotations CASCADE via scenes FK" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f1e6;strokeColor=#a8c8a4;align=left;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="30" y="270" width="1450" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="a_step4" value="④ shutil.rmtree(/data/scenes/&lt;id&gt;/)   AND   shutil.rmtree(/artifacts/scenes/&lt;id&gt;/) — raw + vendable + annotation files + thumbnails + pre-rendered visualizations" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3e6f3;strokeColor=#a874a8;align=left;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="30" y="300" width="1450" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="a_step5" value="⑤ 204 No Content    (frontend redirects to /scenes; ScenesPage reload picks up the gone row)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef3f8;strokeColor=#aac4e0;align=left;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="30" y="346" width="1450" height="22" as="geometry"/>
                </mxCell>

                <!-- ============================================================ -->
                <!-- SECTION B: action delete                                      -->
                <!-- ============================================================ -->
                <mxCell id="sec_b" value="B · DELETE /actions/{id} — single Action removal inside a Project" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;fontStyle=1;fontSize=13;" parent="1" vertex="1">
                    <mxGeometry x="30" y="400" width="1450" height="28" as="geometry"/>
                </mxCell>

                <mxCell id="b_browser" value="Browser (ActionsListPane row)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="60" y="440" width="240" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="b_api" value="api" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="420" y="440" width="120" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="b_pg" value="postgres (CASCADE outputs + visualizations FK)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="680" y="440" width="320" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="b_art" value="allotrope_artifacts · projects/&lt;pid&gt;/actions/&lt;aid&gt;/ + projects/&lt;pid&gt;/visualizations/&lt;orphan-vid&gt;/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8d5e8;strokeColor=#a874a8;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="1040" y="440" width="430" height="36" as="geometry"/>
                </mxCell>

                <mxCell id="b_step1" value="① DELETE /actions/action_&amp;lt;uuid&amp;gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef3f8;strokeColor=#aac4e0;align=left;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="30" y="490" width="1450" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="b_step2" value="② Guard: action.status == 'running' → 409 action_running (cooperative cancel first, wait for terminal, then delete)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2e0;strokeColor=#e0b070;align=left;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="30" y="520" width="1450" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="b_step3" value="③ Pre-collect orphan viz dirs: SELECT v.artifact_path FROM visualizations v JOIN action_outputs o ON v.source_action_output_id=o.id WHERE o.action_id=$1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d6b656;align=left;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="30" y="550" width="1450" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="b_step4" value="④ DELETE FROM actions WHERE id=$1; COMMIT — action_outputs and source-action-output Visualizations CASCADE here" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f1e6;strokeColor=#a8c8a4;align=left;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="30" y="580" width="1450" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="b_step5" value="⑤ shutil.rmtree(projects/&lt;pid&gt;/actions/&lt;aid&gt;/) + rmtree each orphan visualization dir captured in step ③ — without step ③ the viz dirs would linger after their DB rows CASCADE-dropped" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3e6f3;strokeColor=#a874a8;align=left;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="30" y="610" width="1450" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="b_step6" value="⑥ 204 No Content    (workspace ActionsListPane drops the row on next refresh; Job rows persist as audit history with a dangling target_id, which the Jobs UI tolerates)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef3f8;strokeColor=#aac4e0;align=left;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="30" y="656" width="1450" height="22" as="geometry"/>
                </mxCell>

                <!-- ============================================================ -->
                <!-- SECTION C: visualization delete                               -->
                <!-- ============================================================ -->
                <mxCell id="sec_c" value="C · DELETE /visualizations/{id} — single saved frame" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#cffafe;strokeColor=#0891b2;align=left;verticalAlign=middle;fontStyle=1;fontSize=13;" parent="1" vertex="1">
                    <mxGeometry x="30" y="710" width="1450" height="28" as="geometry"/>
                </mxCell>

                <mxCell id="c_browser" value="Browser (VisualizationsPane)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="60" y="750" width="240" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="c_api" value="api" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="420" y="750" width="120" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="c_pg" value="postgres (CASCADE NoteReference.ref_viz_id)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="680" y="750" width="320" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="c_art" value="allotrope_artifacts · projects/&lt;pid&gt;/visualizations/&lt;vid&gt;/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8d5e8;strokeColor=#a874a8;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="1040" y="750" width="430" height="36" as="geometry"/>
                </mxCell>

                <mxCell id="c_step1" value="① DELETE /visualizations/viz_&amp;lt;uuid&amp;gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef3f8;strokeColor=#aac4e0;align=left;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="30" y="800" width="1450" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="c_step2" value="② Capture viz.artifact_path → derive parent dir = projects/&lt;pid&gt;/visualizations/&lt;vid&gt;/ BEFORE the DELETE (FK ON DELETE CASCADE drops NoteReference rows pointing here)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2e0;strokeColor=#e0b070;align=left;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="30" y="830" width="1450" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="c_step3" value="③ DELETE FROM visualizations WHERE id=$1; COMMIT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f1e6;strokeColor=#a8c8a4;align=left;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="30" y="860" width="1450" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="c_step4" value="④ shutil.rmtree(projects/&lt;pid&gt;/visualizations/&lt;vid&gt;/)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3e6f3;strokeColor=#a874a8;align=left;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="30" y="890" width="1450" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="c_step5" value="⑤ 204 No Content    (VisualizationsPane reload removes the card; Notes lose their @[viz](viz_…) chip via cascaded NoteReference)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef3f8;strokeColor=#aac4e0;align=left;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="30" y="920" width="1450" height="22" as="geometry"/>
                </mxCell>

                <!-- ============================================================ -->
                <!-- COMMON NOTE -->
                <!-- ============================================================ -->
                <mxCell id="common" value="Common pattern across all three: filesystem cleanup runs AFTER the DB COMMIT, never inside it. The DB row is the source of truth — if rmtree fails post-commit we log a WARNING but still return 204; if rmtree ran first and the COMMIT failed, we'd have deleted files referenced by a still-live row, which is worse. Best-effort cleanup is the right floor for v1; a sweeper job to GC orphan dirs is on the roadmap as a future ergonomics fix." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="30" y="975" width="1450" height="85" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>
