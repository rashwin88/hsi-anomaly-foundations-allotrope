                </mxCell>

                <mxCell id="phase1" value="① claim → mark running (early commit so UI sees the transition)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef3f8;strokeColor=#aac4e0;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="30" y="150" width="1460" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="msg1a" value="claim_one() → SELECT … FOR UPDATE SKIP LOCKED → UPDATE jobs status=&apos;running&apos;, claimed_by, started_at" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="170" y="200" as="sourcePoint"/><mxPoint x="1350" y="200" as="targetPoint"/></mxGeometry>
                </mxCell>
                <mxCell id="msg1b" value="dispatch by job.type → handle_action_run(session, job)" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="170" y="235" as="sourcePoint"/><mxPoint x="450" y="235" as="targetPoint"/></mxGeometry>
                </mxCell>
                <mxCell id="msg1c" value="db.get(Action, job.target_id) · Project · Scene · spec=get_spec(action.type)" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="450" y="270" as="sourcePoint"/><mxPoint x="1350" y="270" as="targetPoint"/></mxGeometry>
                </mxCell>
                <mxCell id="msg1d" value="UPDATE actions SET status=&apos;running&apos;, started_at=NOW(); COMMIT  ← early commit; UI now sees Action running" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="450" y="305" as="sourcePoint"/><mxPoint x="1350" y="305" as="targetPoint"/></mxGeometry>
                </mxCell>

                <mxCell id="phase2" value="② Build ActionRunContext + create output dir on /artifacts" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2e0;strokeColor=#e0b070;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="30" y="335" width="1460" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="msg2" value="ctx = ActionRunContext(action_id, project_id, scene_id, sensor_type, configuration, data_dir, artifacts_dir, output_dir=projects/&amp;lt;p&amp;gt;/actions/&amp;lt;a&amp;gt;/output, scene_raw_path, on_step, resolve_action_output)" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontStyle=2;fontColor=#444444;" parent="1" vertex="1">
                    <mxGeometry x="200" y="370" width="1280" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="msg2b" value="output_dir.mkdir(parents=True, exist_ok=True)  ← FS side-effect on allotrope_artifacts" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontStyle=2;fontColor=#444444;" parent="1" vertex="1">
                    <mxGeometry x="200" y="395" width="900" height="20" as="geometry"/>
                </mxCell>

                <mxCell id="phase3" value="③ Dispatch to type module: run · summarize · preview" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0e0f0;strokeColor=#b070b0;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="30" y="425" width="1460" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="msg3a" value="spec.run(ctx)  ← lazy-imports app/, numpy, rasterio. Calls ctx.on_step(&apos;…&apos;) between recipe boundaries (heartbeat hook)" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="450" y="475" as="sourcePoint"/><mxPoint x="1020" y="475" as="targetPoint"/></mxGeometry>
                </mxCell>
                <mxCell id="msg3b" value="… recipe FS writes (pickle / GeoTIFFs / diagnostics.json) under output_dir …" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontStyle=2;fontColor=#888888;" parent="1" vertex="1">
                    <mxGeometry x="850" y="500" width="600" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="msg3c" value="spec.summarize(ctx, output_dir) → dict (reads diagnostics.json)" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="450" y="530" as="sourcePoint"/><mxPoint x="1020" y="530" as="targetPoint"/></mxGeometry>
                </mxCell>
                <mxCell id="msg3d" value="spec.preview(ctx, output_dir) → preview.png  (best-effort; failure logged but does NOT fail the Action)" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="450" y="565" as="sourcePoint"/><mxPoint x="1020" y="565" as="targetPoint"/></mxGeometry>
                </mxCell>

                <mxCell id="phase4_fail" value="④a Failure path: any exception during run/summarize → mark Action failed (own commit) and re-raise" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffd6d6;strokeColor=#c97070;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="30" y="595" width="1460" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="msg4a" value="UPDATE actions SET status=&apos;failed&apos;, completed_at=NOW(), failure_reason=&amp;lt;exc class:msg, capped 1000 chars&amp;gt;; COMMIT" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="450" y="645" as="sourcePoint"/><mxPoint x="1350" y="645" as="targetPoint"/></mxGeometry>
                </mxCell>
                <mxCell id="msg4b" value="raise → runner.mark_failed(session, job, …) → UPDATE jobs SET status=&apos;failed&apos;, failure_reason; COMMIT" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="450" y="680" as="sourcePoint"/><mxPoint x="170" y="680" as="targetPoint"/></mxGeometry>
                </mxCell>

                <mxCell id="phase4_ok" value="④b Success path: stage ActionOutput row + Action complete; runner&apos;s mark_complete COMMITs everything" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="30" y="710" width="1460" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="msg5a" value="session.add(ActionOutput(id, action_id=action.id, artifact_path=output_dir_rel, summary=…))" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="450" y="760" as="sourcePoint"/><mxPoint x="1350" y="760" as="targetPoint"/></mxGeometry>
                </mxCell>
                <mxCell id="msg5b" value="UPDATE actions SET status=&apos;complete&apos;, completed_at=NOW()" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="450" y="795" as="sourcePoint"/><mxPoint x="1350" y="795" as="targetPoint"/></mxGeometry>
                </mxCell>
                <mxCell id="msg5c" value="session.flush()  ← surfaces UNIQUE(action_id) violation now, not at commit" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontStyle=2;fontColor=#444444;" parent="1" vertex="1">
                    <mxGeometry x="600" y="820" width="600" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="msg5d" value="return (target_kind=&apos;action_output&apos;, target_id=output.id) → runner.mark_complete: UPDATE jobs status=&apos;complete&apos;, target_kind, target_id, completed_at; COMMIT" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="450" y="855" as="sourcePoint"/><mxPoint x="1350" y="855" as="targetPoint"/></mxGeometry>
                </mxCell>

                <mxCell id="note" value="Invariants: (a) actions.status=&apos;complete&apos; ⇔ exactly one action_outputs row exists (UNIQUE(action_id) enforces it). (b) actions.status and jobs.status are aligned at every transaction boundary: queued/queued · running/running · complete/complete · failed/failed. (c) Cancellation deferred — when added, worker checks actions.cancellation_requested between ctx.on_step calls. (d) Heavy imports (numpy, rasterio, app/) live inside spec.run/preview only — dispatch module stays cheap to import." style="text;html=1;fontSize=10;align=left;verticalAlign=top;fillColor=#fafafa;strokeColor=#cccccc;fontColor=#444444;" parent="1" vertex="1">
                    <mxGeometry x="40" y="885" width="1450" height="60" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>
