                <mxCell id="title" value="Worker action_run handler — claim job · dispatch via action_types registry · lockstep status mirroring on actions / jobs / action_outputs" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="40" y="20" width="1420" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="subtitle" value="One ticking worker loop · one Action at a time. The handler owns the queued→running early-commit AND the action_outputs row materialisation in the runner&apos;s same-txn complete path. Per-type math (`run / summarize / preview`) is dispatched through the action_types REGISTRY." style="text;html=1;fontSize=12;fontStyle=2;fontColor=#666666;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="40" y="52" width="1420" height="20" as="geometry"/>
                </mxCell>

                <mxCell id="actor_runner" value="worker.runner._process_one_tick" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="60" y="85" width="220" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="actor_handler" value="handle_action_run" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="360" y="85" width="180" height="40" as="geometry"/>
