                    <mxGeometry x="880" y="85" width="280" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="actor_pg" value="postgres (jobs · actions · action_outputs)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="1220" y="85" width="260" height="40" as="geometry"/>
