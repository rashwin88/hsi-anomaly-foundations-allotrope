                <mxCell id="actor_reg" value="action_types REGISTRY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="640" y="85" width="180" height="40" as="geometry"/>
