                <mxCell id="ll_browser" style="endArrow=none;dashed=1;html=1;rounded=0;strokeColor=#999999;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="220" y="125" as="sourcePoint"/><mxPoint x="220" y="500" as="targetPoint"/></mxGeometry>
                </mxCell>
                <mxCell id="ll_api" style="endArrow=none;dashed=1;html=1;rounded=0;strokeColor=#999999;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="620" y="125" as="sourcePoint"/><mxPoint x="620" y="500" as="targetPoint"/></mxGeometry>
                </mxCell>
                <mxCell id="ll_reg" style="endArrow=none;dashed=1;html=1;rounded=0;strokeColor=#999999;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="1030" y="125" as="sourcePoint"/><mxPoint x="1030" y="500" as="targetPoint"/></mxGeometry>
                </mxCell>

                <mxCell id="phase1" value="① Request" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef3f8;strokeColor=#aac4e0;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="30" y="150" width="1340" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="msg1" value="GET /api/action-types — Cookie: allotrope_jwt" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="220" y="200" as="sourcePoint"/><mxPoint x="620" y="200" as="targetPoint"/></mxGeometry>
                </mxCell>

                <mxCell id="phase2" value="② Auth (current_user_claims)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2e0;strokeColor=#e0b070;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="30" y="225" width="1340" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="msg2" value="decode JWT → Claims; 401 if missing/invalid" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontStyle=2;fontColor=#444444;" parent="1" vertex="1">
                    <mxGeometry x="450" y="260" width="400" height="20" as="geometry"/>
                </mxCell>

                <mxCell id="phase3" value="③ Walk REGISTRY · serialise META" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0e0f0;strokeColor=#b070b0;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="30" y="290" width="1340" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="msg3" value="for each spec in REGISTRY.values(): spec.META.model_dump(mode=&apos;json&apos;)" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="620" y="340" as="sourcePoint"/><mxPoint x="1030" y="340" as="targetPoint"/></mxGeometry>
