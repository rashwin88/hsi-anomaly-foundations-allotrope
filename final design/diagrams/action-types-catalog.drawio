                <mxCell id="title" value="GET /action-types — public catalog of action types (label · description · inputs · outputs · sensor compatibility · defaults)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="40" y="20" width="1320" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="subtitle" value="No DB. Reads the in-process action_types REGISTRY and emits each module&apos;s META payload as JSON. Powers the &apos;+ New Action&apos; picker dialog AND the Action card on the workspace center pane." style="text;html=1;fontSize=12;fontStyle=2;fontColor=#666666;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="40" y="52" width="1320" height="20" as="geometry"/>
                </mxCell>

                <mxCell id="actor_browser" value="Browser (NewActionDialog · ActionCard)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="80" y="85" width="280" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="actor_api" value="api (FastAPI)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="540" y="85" width="160" height="40" as="geometry"/>
