                <mxCell id="msg3b" value="list of META dicts (label, description, inputs, outputs, sensors, defaults_per_sensor)" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;dashed=1;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="1030" y="375" as="sourcePoint"/><mxPoint x="620" y="375" as="targetPoint"/></mxGeometry>
                </mxCell>

                <mxCell id="phase4" value="④ Response" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="30" y="400" width="1340" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="msg4" value="200 — ActionTypeCatalog{ items: [...] }" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"><mxPoint x="620" y="450" as="sourcePoint"/><mxPoint x="220" y="450" as="targetPoint"/></mxGeometry>
                </mxCell>

                <mxCell id="note" value="No DB queries. Catalog is rebuilt on every request (cheap — small enumerable). Response is cacheable per-session by the frontend; we don&apos;t set Cache-Control because adding a new action type triggers an api rebuild anyway." style="text;html=1;fontSize=10;align=left;verticalAlign=top;fillColor=#fafafa;strokeColor=#cccccc;fontColor=#444444;" parent="1" vertex="1">
                    <mxGeometry x="40" y="478" width="1300" height="40" as="geometry"/>
                </mxCell>
