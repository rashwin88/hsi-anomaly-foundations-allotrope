    <diagram id="action_types_catalog" name="GET /action-types">
        <mxGraphModel dx="1502" dy="931" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="540" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
