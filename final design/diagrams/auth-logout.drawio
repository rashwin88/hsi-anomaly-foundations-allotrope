                <mxCell id="title" value="POST /auth/logout — implementation sequence" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="40" y="20" width="800" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="subtitle" value="Stateless logout: clear the cookie, no DB write. Token remains valid until exp; the browser just no longer holds it." style="text;html=1;fontSize=12;fontStyle=2;fontColor=#666666;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="40" y="52" width="1100" height="20" as="geometry"/>
