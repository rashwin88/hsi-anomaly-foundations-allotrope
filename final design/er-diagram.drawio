                    <mxGeometry x="40" y="20" width="500" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="auth_subtitle" value="Login · Authenticated request · Logout · HS256 / HttpOnly+SameSite=Strict cookie" style="text;html=1;fontSize=12;fontStyle=2;fontColor=#666666;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="40" y="52" width="900" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="actor_client" value="Browser (Client)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="120" y="85" width="160" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="actor_api" value="api (FastAPI)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="520" y="85" width="160" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="actor_db" value="postgres" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="920" y="85" width="160" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="lifeline_client" style="endArrow=none;dashed=1;html=1;rounded=0;strokeColor=#999999;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="200" y="125" as="sourcePoint"/>
                        <mxPoint x="200" y="900" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="lifeline_api" style="endArrow=none;dashed=1;html=1;rounded=0;strokeColor=#999999;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="600" y="125" as="sourcePoint"/>
                        <mxPoint x="600" y="900" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="lifeline_db" style="endArrow=none;dashed=1;html=1;rounded=0;strokeColor=#999999;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="1000" y="125" as="sourcePoint"/>
                        <mxPoint x="1000" y="900" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="phase1_band" value="① Login — POST /auth/login" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef3f8;strokeColor=#aac4e0;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="30" y="140" width="1100" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="msg_login_1" value="POST /auth/login&lt;br/&gt;{ username, password }" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="200" y="190" as="sourcePoint"/>
                        <mxPoint x="600" y="190" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="msg_login_2" value="SELECT user WHERE LOWER(username)=$1" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="600" y="225" as="sourcePoint"/>
                        <mxPoint x="1000" y="225" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="msg_login_3" value="user row" style="endArrow=open;html=1;edgeStyle=none;dashed=1;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="1000" y="255" as="sourcePoint"/>
                        <mxPoint x="600" y="255" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="note_login" value="argon2id_verify(password)&lt;br/&gt;build claims { sub, iat, exp, username }&lt;br/&gt;sign with HMAC-SHA256(secret, header.payload)" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="430" y="280" width="340" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="msg_login_4" value="UPDATE users SET last_login_at = now()" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="600" y="370" as="sourcePoint"/>
                        <mxPoint x="1000" y="370" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="msg_login_5" value="200 OK&lt;br/&gt;Set-Cookie: allotrope_jwt=…; HttpOnly; Secure; SameSite=Strict; Max-Age=86400" style="endArrow=open;html=1;edgeStyle=none;dashed=1;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="600" y="410" as="sourcePoint"/>
                        <mxPoint x="200" y="410" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="phase2_band" value="② Authenticated request — every other endpoint" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f1e6;strokeColor=#a8c8a4;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="30" y="450" width="1100" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="msg_auth_1" value="GET /projects&lt;br/&gt;Cookie: allotrope_jwt (auto-attached by browser)" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="200" y="500" as="sourcePoint"/>
                        <mxPoint x="600" y="500" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="note_auth" value="middleware:&lt;br/&gt;1. read cookie&lt;br/&gt;2. recompute signature with secret&lt;br/&gt;3. constant-time compare&lt;br/&gt;4. check exp &amp;gt; now&lt;br/&gt;5. attach claims.sub to request context&lt;br/&gt;&lt;b&gt;no DB read for auth&lt;/b&gt;" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="420" y="525" width="360" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="msg_auth_2" value="SELECT projects WHERE user_id = claims.sub" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="600" y="665" as="sourcePoint"/>
                        <mxPoint x="1000" y="665" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="msg_auth_3" value="rows" style="endArrow=open;html=1;edgeStyle=none;dashed=1;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="1000" y="695" as="sourcePoint"/>
                        <mxPoint x="600" y="695" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="msg_auth_4" value="200 OK [data]" style="endArrow=open;html=1;edgeStyle=none;dashed=1;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="600" y="725" as="sourcePoint"/>
                        <mxPoint x="200" y="725" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="phase3_band" value="③ Logout — POST /auth/logout" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5eef8;strokeColor=#c8a4d0;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="30" y="760" width="1100" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="msg_logout_1" value="POST /auth/logout (Cookie attached)" style="endArrow=classic;html=1;edgeStyle=none;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="200" y="810" as="sourcePoint"/>
                        <mxPoint x="600" y="810" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="msg_logout_2" value="204 No Content&lt;br/&gt;Set-Cookie: allotrope_jwt=; Max-Age=0" style="endArrow=open;html=1;edgeStyle=none;dashed=1;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="600" y="845" as="sourcePoint"/>
                        <mxPoint x="200" y="845" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="logout_note" value="No DB write on logout. Token remains technically valid until its exp, but the browser no longer holds it." style="text;html=1;fontSize=11;fontStyle=2;fontColor=#666666;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="200" y="870" width="800" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="legend_auth" value="&lt;div style=&quot;line-height:1.7;font-size:11px&quot;&gt;&lt;b&gt;solid arrow&lt;/b&gt; — request&lt;br/&gt;&lt;b&gt;dashed arrow&lt;/b&gt; — response&lt;br/&gt;&lt;b&gt;yellow note&lt;/b&gt; — local computation on the api (no I/O)&lt;br/&gt;&lt;b&gt;phase bands&lt;/b&gt; — login (blue), authenticated (green), logout (purple)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fillColor=#fafafa;strokeColor=#cccccc;" parent="1" vertex="1">
                    <mxGeometry x="40" y="910" width="600" height="80" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="onboarding_flow" name="Onboarding Flow">
