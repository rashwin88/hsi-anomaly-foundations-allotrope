                <mxCell id="annotation_entity" value="&lt;div style=&quot;text-align:center;font-weight:bold;font-size:14px;border-bottom:1px solid #888;padding:8px 0;background:#fdf2e0&quot;&gt;Annotation&lt;/div&gt;&lt;div style=&quot;padding:10px 14px;line-height:1.6&quot;&gt;&lt;div&gt;&lt;b&gt;id&lt;/b&gt; : uuid (PK)&lt;/div&gt;&lt;div&gt;&lt;b&gt;scene_id&lt;/b&gt; : uuid (FK)&lt;/div&gt;&lt;div&gt;type : text (enum: raster_mask)&lt;/div&gt;&lt;div&gt;name : text&lt;/div&gt;&lt;div&gt;description : text?&lt;/div&gt;&lt;div&gt;file_path : text&lt;/div&gt;&lt;div&gt;metadata : jsonb&lt;/div&gt;&lt;div&gt;created_at : timestamptz&lt;/div&gt;&lt;div&gt;&lt;b&gt;created_by_user_id&lt;/b&gt; : uuid? (FK)&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;padding:6px 14px;font-size:10px;color:#888;border-top:1px dashed #ccc&quot;&gt;wire: annotation_&amp;lt;uuid&amp;gt; · CASCADE on Scene-delete · path: scenes/&amp;lt;scene_id&amp;gt;/annotations/&amp;lt;id&amp;gt;/&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=12;fillColor=#ffffff;strokeColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="720" y="110" width="300" height="320" as="geometry"/>
                </mxCell>
                <mxCell id="auth_note" value="&lt;div style=&quot;font-size:11px;line-height:1.55;color:#444&quot;&gt;&lt;b&gt;Auth model: JWT (stateless)&lt;/b&gt;&lt;br/&gt;HS256 · HttpOnly+SameSite=Strict cookie&lt;br/&gt;24h expiry · no sessions table&lt;br/&gt;claims: sub, iat, exp, username&lt;br/&gt;&lt;span style=&quot;color:#888&quot;&gt;(see &quot;Auth Flow (JWT)&quot; sheet)&lt;/span&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fillColor=#fff8e7;strokeColor=#d6b86a;dashed=1;" parent="1" vertex="1">
                    <mxGeometry x="1080" y="110" width="440" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="audit_note" value="&lt;div style=&quot;font-size:11px;line-height:1.55;color:#444&quot;&gt;&lt;b&gt;Audit refs (not drawn as edges)&lt;/b&gt;&lt;br/&gt;Scene.created_by_user_id → User.id   (SET NULL)&lt;br/&gt;Annotation.created_by_user_id → User.id   (SET NULL)&lt;br/&gt;&lt;span style=&quot;color:#888&quot;&gt;Library is shared; created_by is informational, not ownership.&lt;/span&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fillColor=#fafafa;strokeColor=#cccccc;" parent="1" vertex="1">
