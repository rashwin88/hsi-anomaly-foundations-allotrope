                <mxCell id="ob_subtitle" value="Submit · Worker pickup &amp; processing · Status polling — async via Postgres-backed jobs queue" style="text;html=1;fontSize=12;fontStyle=2;fontColor=#666666;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="40" y="52" width="1100" height="20" as="geometry"/>
