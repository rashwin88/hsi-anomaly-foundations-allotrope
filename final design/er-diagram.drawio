    <diagram id="auth_flow" name="Auth Flow (JWT)">
        <mxGraphModel dx="693" dy="762" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="950" math="0" shadow="0">
            <root>
