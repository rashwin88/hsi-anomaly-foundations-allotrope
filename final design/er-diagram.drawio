                <mxCell id="user_entity" value="&lt;div style=&quot;text-align:center;font-weight:bold;font-size:14px;border-bottom:1px solid #888;padding:8px 0;background:#eef3f8&quot;&gt;User&lt;/div&gt;&lt;div style=&quot;padding:10px 14px;line-height:1.6&quot;&gt;&lt;div&gt;&lt;b&gt;id&lt;/b&gt; : uuid (PK)&lt;/div&gt;&lt;div&gt;username : text (unique, ci)&lt;/div&gt;&lt;div&gt;email : text (unique, ci)&lt;/div&gt;&lt;div&gt;password_hash : text&lt;/div&gt;&lt;div&gt;display_name : text?&lt;/div&gt;&lt;div&gt;last_login_at : timestamptz?&lt;/div&gt;&lt;div&gt;created_at : timestamptz&lt;/div&gt;&lt;div&gt;updated_at : timestamptz&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;padding:6px 14px;font-size:10px;color:#888;border-top:1px dashed #ccc&quot;&gt;wire: user_&amp;lt;uuid&amp;gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=12;fillColor=#ffffff;strokeColor=#333333;" parent="1" vertex="1">
