                <mxCell id="scene_entity" value="&lt;div style=&quot;text-align:center;font-weight:bold;font-size:14px;border-bottom:1px solid #888;padding:8px 0;background:#e8f1e6&quot;&gt;Scene&lt;/div&gt;&lt;div style=&quot;padding:10px 14px;line-height:1.6&quot;&gt;&lt;div&gt;&lt;b&gt;id&lt;/b&gt; : uuid (PK)&lt;/div&gt;&lt;div&gt;sensor_type : text (enum)&lt;/div&gt;&lt;div&gt;sensor_scene_id : text&lt;/div&gt;&lt;div&gt;name : text&lt;/div&gt;&lt;div&gt;acquisition_at : timestamptz?&lt;/div&gt;&lt;div&gt;processing_level : text?&lt;/div&gt;&lt;div&gt;product_type : text?&lt;/div&gt;&lt;div&gt;bbox_min_lon : numeric&lt;/div&gt;&lt;div&gt;bbox_min_lat : numeric&lt;/div&gt;&lt;div&gt;bbox_max_lon : numeric&lt;/div&gt;&lt;div&gt;bbox_max_lat : numeric&lt;/div&gt;&lt;div&gt;native_projection : text?&lt;/div&gt;&lt;div&gt;band_count : int&lt;/div&gt;&lt;div&gt;cloud_cover_pct : numeric?&lt;/div&gt;&lt;div&gt;valid_pixel_pct : numeric?&lt;/div&gt;&lt;div&gt;has_annotations : boolean&lt;/div&gt;&lt;div&gt;metadata : jsonb&lt;/div&gt;&lt;div&gt;raw_path : text&lt;/div&gt;&lt;div&gt;vendable_path : text&lt;/div&gt;&lt;div&gt;thumbnail_path : text?&lt;/div&gt;&lt;div&gt;created_at : timestamptz&lt;/div&gt;&lt;div&gt;&lt;b&gt;created_by_user_id&lt;/b&gt; : uuid? (FK)&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;padding:6px 14px;font-size:10px;color:#888;border-top:1px dashed #ccc&quot;&gt;wire: scene_&amp;lt;uuid&amp;gt; · UNIQUE(sensor_type, sensor_scene_id) · bbox in EPSG:4326&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=12;fillColor=#ffffff;strokeColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="340" y="110" width="320" height="560" as="geometry"/>
