\addvspace {10\p@ }
\contentsline {figure}{\numberline {48.1}{\ignorespaces pAUC on the PRISMA bench. HyperSL's own residual (L2, loss) sits near zero; scored with residual Mahalanobis it lands below PCA-RX, which uses no model at all. Data \texttt {figdata/\allowbreak hsl\_detect\_bar.dat}.\relax }}{729}{figure.caption.567}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {49.1}{\ignorespaces mSAD on the four exact-truth sets. The classical method is near zero on DC1, DC2 and EGU; every HyperSL preset is 0.08--0.26\,rad. The last two bars, pretrained and random backbone, are nearly the same height.\relax }}{735}{figure.caption.577}%
\contentsline {figure}{\numberline {49.2}{\ignorespaces HySU object AUC against target size. Every method finds targets of 1\,m and more when told the material; below one pixel, HyperSL anchored falls to 0.68 and 0.77 while per-pixel ACE stays at 0.97--1.00.\relax }}{737}{figure.caption.582}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {50.1}{\ignorespaces Share of each EnMAP-labelled class the classifier finds, out of fold over 47 datatakes. HyperSL's features lose most on cirrus, the thin class, and on snow.\relax }}{743}{figure.caption.588}%
