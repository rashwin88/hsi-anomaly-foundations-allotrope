# Allotrope — local environment template
#
# Copy this file to `.env` (which is gitignored) and fill in the values:
#     cp docker/.env.example docker/.env
# Then bring the stack up:
#     docker compose -f docker/docker-compose.yml up -d

# --- Postgres ------------------------------------------------------------

# Database / user names. Defaults are fine for dev; override only if you have
# a reason. The same names appear in the api / worker connection strings.
POSTGRES_DB=allotrope
POSTGRES_USER=allotrope

# REQUIRED. Pick a long random string; this becomes the password for the
# `allotrope` Postgres user. Compose will refuse to start if this is unset.
# Suggested: `openssl rand -base64 32`
POSTGRES_PASSWORD=

# --- Admin seed --------------------------------------------------------
# Used only by the seed-admin CLI:
#     docker compose -f docker/docker-compose.yml run --rm api \
#         python -m allotrope.cli seed-admin
# The api itself ignores these.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@allotrope.local
ADMIN_PASSWORD=

# --- JWT ---------------------------------------------------------------
# REQUIRED. Signing secret for HS256 JWTs. Rotating this invalidates every
# token in flight (our nuclear-option revocation).
# Suggested: `openssl rand -base64 32`
JWT_SECRET=
