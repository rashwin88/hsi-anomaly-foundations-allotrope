                <mxCell id="m1" value="transform(cube, validity_mask, **kwargs)" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeColor=#000000;fontSize=11;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="140" y="160" as="sourcePoint"/>
                        <mxPoint x="370" y="160" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="note1" value="init _last_detected_angles = []&#xa;validate validity_mask present&#xa;capture = diagnostics flag" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=15;fillColor=#ffffc0;strokeColor=#999900;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="390" y="170" width="200" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="m2" value="STAGE 1: _find_stripe_angles(cube, validity, ...)" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeColor=#000000;fontSize=11;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="370" y="260" as="sourcePoint"/>
                        <mxPoint x="620" y="260" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="m3" value="_select_probe_bands(cube, validity, band_wavelengths, spectral_family_order)" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeColor=#000000;fontSize=11;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="620" y="310" as="sourcePoint"/>
                        <mxPoint x="870" y="310" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="note_spb" value="1. Compute per-band invalid pixel counts&#xa;2. Build SpectralBandFilter good-band set&#xa;3. If spectral_family_order provided:&#xa;   • For VNIR pool: filter by family, &lt;10% invalid&#xa;   • For SWIR pool: filter by family, &lt;10% invalid&#xa;   • From each pool: evenly spaced, highest variance&#xa;4. Else: single pool (original behaviour)&#xa;→ Returns list of probe band indices" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=15;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="870" y="150" width="290" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="m4" value="probe_indices (up to 20 bands)" style="edgeStyle=orthogonalEdgeStyle;endArrow=open;endFill=0;dashed=1;strokeColor=#000000;fontSize=11;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="870" y="445" as="sourcePoint"/>
                        <mxPoint x="620" y="445" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="loop_box" value="loop: for each probe band" style="shape=mxgraph.sequence.loop;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;fontSize=11;fillColor=#f9f9f9;strokeColor=#666666;" parent="1" vertex="1">
                    <mxGeometry x="560" y="465" width="300" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="loop_note" value="_fill_invalid → mean-fill invalid px&#xa;_compute_log_power_spectrum → FFT2, shift, log|P|²&#xa;_radial_power_vs_angle → sum power per angle (0–179°)&#xa;peak above 3σ bg? → append to candidate_angles" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="565" y="485" width="285" height="95" as="geometry"/>
                </mxCell>
                <mxCell id="m5_note" value="_find_all_consensus_angles(candidate_angles)&#xa;Greedy cluster extraction with ANGLE_TOLERANCE=3°&#xa;required = max(2, N//4) support&#xa;→ consensus_angles (may be empty)" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=15;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="560" y="610" width="300" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="m5b_note" value="For each consensus angle:&#xa;  Use rep_idx (middle probe band)&#xa;  Compute strength = (peak − bg_mean) / bg_std&#xa;  Map strength → radial_preserve (2 / 3 / 5)&#xa;  Append (angle, strength) pair" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=15;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="560" y="710" width="300" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="m5" value="angle_strength_pairs [(angle°, σ), ...]" style="edgeStyle=orthogonalEdgeStyle;endArrow=open;endFill=0;dashed=1;strokeColor=#000000;fontSize=11;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="620" y="810" as="sourcePoint"/>
                        <mxPoint x="370" y="810" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="note_early" value="if no pairs → return cube.copy() unchanged" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=15;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="390" y="825" width="240" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="stage2_label" value="STAGE 2: build combined notch filter" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="390" y="880" width="320" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="note_notch_init" value="notch = ones(padded_shape)  [H+256, W+256]" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=15;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="390" y="905" width="290" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="loop_notch" value="loop: for each (angle, strength)" style="shape=mxgraph.sequence.loop;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;fontSize=11;fillColor=#f9f9f9;strokeColor=#666666;" parent="1" vertex="1">
                    <mxGeometry x="350" y="945" width="560" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="m6" value="_build_notch_filter(padded_shape, angle, radial_preserve)" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeColor=#000000;fontSize=11;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="370" y="965" as="sourcePoint"/>
                        <mxPoint x="1120" y="965" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="note_bnf" value="1. Compute per-pixel angle from DC centre&#xa;2. Zero wedge: angle_diff ≤ angular_width (3°)&#xa;3. Gaussian taper (σ=2) to smooth wedge edges&#xa;4. Hard restore centre: dist ≤ radial_preserve → 1.0&#xa;→ Returns per-angle notch [0,1] array" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=15;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="1140" y="950" width="270" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="m7" value="per_angle_notch" style="edgeStyle=orthogonalEdgeStyle;endArrow=open;endFill=0;dashed=1;strokeColor=#000000;fontSize=11;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="1120" y="1020" as="sourcePoint"/>
                        <mxPoint x="370" y="1020" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="note_combined" value="notch = element-wise min(notch, per_angle_notch)&#xa;→ multi-angle composite notch" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=15;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="390" y="1030" width="270" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="note_stored" value="self._last_detected_angles = [angles]  (always stored)" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=15;fillColor=#ffffc0;strokeColor=#999900;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="390" y="1080" width="300" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="stage3_label" value="STAGE 3: apply filter to all bands" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="390" y="1120" width="280" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="m8" value="_apply_filter(cube, validity, notch, diag)" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeColor=#000000;fontSize=11;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="370" y="1150" as="sourcePoint"/>
                        <mxPoint x="1360" y="1150" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="note_af" value="for b in 0..B-1:&#xa;  1. mean-fill invalid pixels&#xa;  2. pad ±128px with band mean&#xa;  3. FFT2 → fftshift → multiply notch&#xa;  4. ifftshift → IFFT2 → real part&#xa;  5. crop [p:p+H, p:p+W]&#xa;  6. write back only valid pixels&#xa;  7. if diag and rep band: capture before/after" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=15;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="1180" y="1135" width="270" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="m9" value="destriped cube (B, H, W), same dtype as input" style="edgeStyle=orthogonalEdgeStyle;endArrow=open;endFill=0;dashed=1;strokeColor=#000000;fontSize=11;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="1360" y="1280" as="sourcePoint"/>
                        <mxPoint x="370" y="1280" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="m10" value="destriped cube" style="edgeStyle=orthogonalEdgeStyle;endArrow=open;endFill=0;dashed=1;strokeColor=#000000;fontSize=11;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="370" y="1310" as="sourcePoint"/>
                        <mxPoint x="140" y="1310" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
