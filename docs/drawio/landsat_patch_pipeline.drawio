<mxfile host="Electron" agent="draw.io" version="28.0.4">
  <diagram name="Landsat Patch Pipeline" id="landsat-patch-pipeline">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ==================== TITLE ==================== -->
        <mxCell id="title" value="Landsat Patch Generation Pipeline" style="text;html=1;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="500" y="20" width="400" height="40" as="geometry" />
        </mxCell>

        <!-- ==================== S3 RAW DATA (source) ==================== -->
        <mxCell id="s3raw" value="S3: allotrope-raw-data-india/landsat/&lt;br&gt;&lt;i&gt;(Raw Landsat scenes: ST_B10 + QA_PIXEL)&lt;/i&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="80" y="90" width="280" height="70" as="geometry" />
        </mxCell>

        <!-- ==================== STAGE 1 CONTAINER ==================== -->
        <mxCell id="stage1box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;dashed=1;dashPattern=5 5;" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="700" height="520" as="geometry" />
        </mxCell>
        <mxCell id="stage1label" value="STAGE 1: Intermediate Sharding&lt;br&gt;&lt;i&gt;LandsatIntermediateSharder&lt;/i&gt;" style="text;html=1;fontSize=14;fontStyle=1;align=left;verticalAlign=top;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="55" y="208" width="350" height="40" as="geometry" />
        </mxCell>

        <!-- s3_searcher -->
        <mxCell id="searcher" value="&lt;b&gt;s3_searcher()&lt;/b&gt;&lt;br&gt;List scene prefixes&lt;br&gt;+ random.shuffle()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="120" y="260" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- s3_downloader -->
        <mxCell id="downloader" value="&lt;b&gt;s3_downloader(scene)&lt;/b&gt;&lt;br&gt;Download ST_B10 + QA_PIXEL&lt;br&gt;→ manifest dict" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="120" y="350" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- LandsatDataBuilder -->
        <mxCell id="builder" value="&lt;b&gt;LandsatDataBuilder&lt;/b&gt;&lt;br&gt;Build VendableThermalDataset&lt;br&gt;&lt;i&gt;(normalized cube, masks)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="120" y="440" width="220" height="60" as="geometry" />
        </mxCell>

        <!-- PatchPlanGenerator -->
        <mxCell id="planner" value="&lt;b&gt;PatchPlanGenerator&lt;/b&gt;&lt;br&gt;Sliding window grid&lt;br&gt;&lt;i&gt;128×128 px, stride 64&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="380" y="440" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- patch_landsat_vendable -->
        <mxCell id="patcher" value="&lt;b&gt;patch_landsat_vendable()&lt;/b&gt;&lt;br&gt;&lt;i&gt;landsat_patcher.py&lt;/i&gt;&lt;br&gt;Yield patch dicts per coordinate&lt;br&gt;(pixels, masks, metadata)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="220" y="535" width="250" height="70" as="geometry" />
        </mxCell>

        <!-- Validity filter -->
        <mxCell id="filter" value="&lt;b&gt;Validity Filter&lt;/b&gt;&lt;br&gt;Keep if &amp;gt;50% valid pixels" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="530" y="535" width="170" height="70" as="geometry" />
        </mxCell>

        <!-- ShardWriter intermediate -->
        <mxCell id="shardwriter1" value="&lt;b&gt;wds.ShardWriter&lt;/b&gt;&lt;br&gt;intermediate_shard_%04d.tar&lt;br&gt;&lt;i&gt;1 GB per shard&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="510" y="640" width="210" height="60" as="geometry" />
        </mxCell>

        <!-- S3 intermediate -->
        <mxCell id="s3inter" value="S3: patches/intermediate/&lt;br&gt;&lt;i&gt;intermediate_shard_XXXX.tar&lt;/i&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="830" y="330" width="250" height="70" as="geometry" />
        </mxCell>

        <!-- upload hook label -->
        <mxCell id="uploadlabel1" value="s3_upload_and_cleanup&lt;br&gt;&lt;i&gt;(post hook on shard close)&lt;/i&gt;" style="text;html=1;fontSize=10;align=center;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="770" y="580" width="170" height="40" as="geometry" />
        </mxCell>

        <!-- ==================== STAGE 2 CONTAINER ==================== -->
        <mxCell id="stage2box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;dashed=1;dashPattern=5 5;" vertex="1" parent="1">
          <mxGeometry x="800" y="440" width="520" height="300" as="geometry" />
        </mxCell>
        <mxCell id="stage2label" value="STAGE 2: Final Sharding&lt;br&gt;&lt;i&gt;FinalPatchShuffler&lt;/i&gt;" style="text;html=1;fontSize=14;fontStyle=1;align=left;verticalAlign=top;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="815" y="448" width="300" height="40" as="geometry" />
        </mxCell>

        <!-- WebDataset streaming -->
        <mxCell id="wds" value="&lt;b&gt;WebDataset&lt;/b&gt;&lt;br&gt;pipe: aws s3 cp (streaming)&lt;br&gt;resampled=True" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="840" y="500" width="210" height="60" as="geometry" />
        </mxCell>

        <!-- Shuffle -->
        <mxCell id="shuffle" value="&lt;b&gt;.shuffle(buffer=10)&lt;/b&gt;&lt;br&gt;Cross-scene mixing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1080" y="500" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- DataLoader -->
        <mxCell id="dataloader" value="&lt;b&gt;DataLoader&lt;/b&gt;&lt;br&gt;num_workers=10&lt;br&gt;Tensor → NumPy conversion" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="840" y="590" width="210" height="60" as="geometry" />
        </mxCell>

        <!-- ShardWriter final -->
        <mxCell id="shardwriter2" value="&lt;b&gt;wds.ShardWriter&lt;/b&gt;&lt;br&gt;final_shard_%05d.tar&lt;br&gt;&lt;i&gt;1 GB per shard&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1080" y="590" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- S3 final -->
        <mxCell id="s3final" value="S3: patches/final/&lt;br&gt;&lt;i&gt;final_shard_XXXXX.tar&lt;/i&gt;&lt;br&gt;&lt;b&gt;ML-Ready&lt;/b&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1080" y="690" width="200" height="70" as="geometry" />
        </mxCell>

        <!-- ==================== PYDANTIC MODELS (right side) ==================== -->
        <mxCell id="patchrequest" value="&lt;b&gt;PatchRequest&lt;/b&gt;&lt;br&gt;&lt;hr&gt;+ input_cube: Tuple[int,int,int]&lt;br&gt;+ width: int&lt;br&gt;+ height: int&lt;br&gt;+ stride: int" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1150" y="90" width="210" height="110" as="geometry" />
        </mxCell>

        <mxCell id="patchplan" value="&lt;b&gt;PatchingPlan&lt;/b&gt;&lt;hr&gt;+ originating_request: PatchRequest&lt;br&gt;+ patch_coordinates: List[Tuple[int,int]]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1150" y="230" width="240" height="80" as="geometry" />
        </mxCell>

        <!-- ==================== EDGES ==================== -->
        <!-- S3 raw → searcher -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="s3raw" target="searcher">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- searcher → downloader -->
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="searcher" target="downloader">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2label" value="for each scene" style="edgeLabel;html=1;fontSize=10;fontStyle=2;" vertex="1" connectable="0" parent="e2">
          <mxGeometry x="-0.1" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- downloader → builder -->
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="downloader" target="builder">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- builder → patcher -->
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="builder" target="patcher">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- planner → patcher -->
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="planner" target="patcher">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- patcher → filter -->
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="patcher" target="filter">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6label" value="yield patch" style="edgeLabel;html=1;fontSize=10;fontStyle=2;" vertex="1" connectable="0" parent="e6">
          <mxGeometry x="-0.1" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- filter → shardwriter1 -->
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="filter" target="shardwriter1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7label" value="if valid" style="edgeLabel;html=1;fontSize=10;fontStyle=2;fontColor=#009900;" vertex="1" connectable="0" parent="e7">
          <mxGeometry x="-0.2" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- shardwriter1 → s3inter -->
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="shardwriter1" target="s3inter">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="770" y="670" />
              <mxPoint x="770" y="365" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- s3inter → wds -->
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="s3inter" target="wds">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- wds → shuffle -->
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="wds" target="shuffle">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- shuffle → dataloader -->
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="shuffle" target="dataloader">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1180" y="580" />
              <mxPoint x="1180" y="580" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- dataloader → shardwriter2 -->
        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="dataloader" target="shardwriter2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- shardwriter2 → s3final -->
        <mxCell id="e13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="shardwriter2" target="s3final">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- PatchRequest → PatchingPlan -->
        <mxCell id="e14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;" edge="1" parent="1" source="patchrequest" target="patchplan">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- planner uses models -->
        <mxCell id="e15" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#999999;" edge="1" parent="1" source="planner" target="patchrequest">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="580" y="420" />
              <mxPoint x="1100" y="420" />
              <mxPoint x="1100" y="145" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e15label" value="uses" style="edgeLabel;html=1;fontSize=10;fontStyle=2;fontColor=#999999;" vertex="1" connectable="0" parent="e15">
          <mxGeometry x="-0.1" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- ==================== LEGEND ==================== -->
        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="1150" y="360" width="60" height="20" as="geometry" />
        </mxCell>
        <mxCell id="leg1" value="S3 storage" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="1150" y="380" width="80" height="30" as="geometry" />
        </mxCell>
        <mxCell id="leg2" value="Processing step" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="1240" y="380" width="100" height="30" as="geometry" />
        </mxCell>
        <mxCell id="leg3" value="Data transform" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="1150" y="415" width="80" height="30" as="geometry" />
        </mxCell>
        <mxCell id="leg4" value="Pydantic model" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="1240" y="415" width="100" height="30" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
