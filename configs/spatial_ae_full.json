{
    "_comment": "Run: python scripts/train_foundation_model.py configs/spatial_ae_full.json",

    "foundation_model_name": "spatial_autoencoder",
    "version": "3.0.0",

    "model_config": {
        "model_type": "spatial_autoencoder",
        "in_channels": 1,
        "base_channels": 32,
        "num_stages": 3
    },

    "data": {
        "num_epochs": 100,
        "data_provider": "landsat",
        "train_samples_per_epoch": {"64": 50000, "128": 12500, "256": 3125, "512": 780},
        "test_samples_per_epoch": {"64": 2000, "128": 500, "256": 200, "512": 200},
        "shard_key_template": "patches/{provider}/{split}/{stage}/w{size}_h{size}_s{stride}/",
        "stage": "final",
        "bucket_name": "allotrope-raw-data-india",
        "region_name": "ap-south-1",
        "batch_size": 256,
        "num_workers": 10,
        "shardshuffle": 30,
        "pixel_stats_path": "/home/user57/constants/thermal.json"
    },

    "learning_rate": 1e-3,

    "lr_schedule": {
        "scheduler_type": "cosine",
        "warmup_epochs": 2,
        "min_lr": 1e-6,
        "step_size": 10,
        "step_gamma": 0.5
    },

    "checkpoint": {
        "checkpoint_dir": "/home/user57/checkpoints/spatial_ae_v2/",
        "save_every_n_epochs": 5,
        "keep_top_k": 3,
        "save_to_s3": false,
        "s3_checkpoint_key": null
    },

    "hot_storage": {
        "enabled": true,
        "local_cache_dir": "/tmp/hot_shards/",
        "train_shards_per_size": 70,
        "test_shards_per_size": 10,
        "skip_sync_if_exists": true,
        "max_parallel_downloads": 30
    },

    "wandb": {
        "enabled": true,
        "project": "allotrope",
        "run_name": "allotrope-spatial-autoencoder-v3.0.0",
        "tags": ["spatial_autoencoder", "landsat", "thermal"]
    },

    "device": null,
    "resume_from": null,
    "resume_mode": "resume"
}