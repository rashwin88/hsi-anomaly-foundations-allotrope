{
    "foundation_model_name": "spatial_autoencoder",
    "version": "0.1.0-trials",
    "model_config": {
        "model_type": "spatial_autoencoder",
        "in_channels": 1,
        "base_channels": 32,
        "num_stages": 3
    },
    "data": {
        "num_epochs": 50,
        "train_samples_per_epoch": {"64": 50000, "128": 12500, "256": 3125, "512": 780},
        "test_samples_per_epoch": {"64": 200, "128": 200, "256": 200, "512": 200},
        "stage": "intermediate",
        "batch_size": 128,
        "num_workers": 20
    },
    "learning_rate": 1e-3,
    "lr_schedule": {
        "scheduler_type": "cosine",
        "warmup_epochs": 2,
        "min_lr": 1e-6
    },
    "checkpoint": {
        "checkpoint_dir": "checkpoints/spatial_ae/",
        "save_every_n_epochs": 5,
        "keep_top_k": 3
    },
    "hot_storage": {
        "enabled": true,
        "local_cache_dir": "/tmp/hot_shards/",
        "train_shards_per_size": 100,
        "test_shards_per_size": 10,
        "skip_sync_if_exists": true,
        "max_parallel_downloads": 30
    }
}