{
    "_comment": "Run: python scripts/train_foundation_model.py configs/hyperspectral_segformer_exp_1.json",
    "_description": "Hyperspectral SegFormer MAE B0 — 165-band input, D=24 spectral compression, L1+SAM loss with 20-epoch ramp. Training on mixed PRISMA+EnMAP final shards (128x128).",

    "foundation_model_name": "hyperspectral_segformer_mae",
    "version": "0.1.0",

    "model_config": {
        "model_type": "hyperspectral_segformer_mae",
        "in_channels": 165,
        "compressed_channels": 24,
        "embed_dims": [32, 64, 160, 256],
        "num_heads": [1, 2, 5, 8],
        "reduction_ratios": [8, 4, 2, 1],
        "num_blocks": [2, 2, 2, 2],
        "decoder_dim": 256,
        "expansion_ratio": 4,
        "drop_rate": 0.3,
        "mask_ratio": 0.5,
        "trim_fraction": 0.0,
        "sam_weight": 1.0,
        "sam_ramp_epochs": 20
    },

    "data": {
        "num_epochs": 500,
        "data_provider": "hyperspectral",
        "train_samples_per_epoch": { "128": 30000 },
        "test_samples_per_epoch": { "128": 5000 },
        "shard_key_template": "patches/{provider}/{split}/{stage}/w{size}_h{size}_s{stride}/",
        "stage": "final",
        "bucket_name": "allotrope-raw-data-india",
        "region_name": "ap-south-1",
        "batch_size": 8,
        "num_workers": 10,
        "shardshuffle": 30,
        "pixel_stats_path": "/home/ubuntu/constants/hyperspectral.json"
    },

    "learning_rate": 1e-4,

    "lr_schedule": {
        "scheduler_type": "cosine",
        "warmup_epochs": 5,
        "min_lr": 1e-6,
        "step_size": 10,
        "step_gamma": 0.5
    },

    "checkpoint": {
        "checkpoint_dir": "/home/ubuntu/checkpoints/hyperspectral_segformer_mae_v1/",
        "save_every_n_epochs": 1,
        "keep_top_k": 3,
        "save_to_s3": false,
        "s3_checkpoint_key": null
    },

    "hot_storage": {
        "enabled": true,
        "local_cache_dir": "/tmp/hot_shards_hsi/",
        "train_shards_per_size": 50,
        "test_shards_per_size": 10,
        "skip_sync_if_exists": true,
        "max_parallel_downloads": 20
    },

    "wandb": {
        "enabled": true,
        "project": "allotrope",
        "run_name": "allotrope-hsi-segformer-mae-v0.1.0",
        "tags": ["hyperspectral_segformer_mae", "prisma", "enmap", "spectral_compression", "sam_loss"]
    },

    "device": null,
    "resume_from": null,
    "resume_mode": "resume"
}
