{
  "name": "cloud-only exclusion (vessels on water are in scope, user 2026-10-17)",
  "models": [
    {
      "name": "FT03_ep10",
      "checkpoint": "s3://allotrope-training-data-prod-india/experiments/indradhanu-finetune/FT03-joint/checkpoints/best.pt"
    }
  ],
  "datasets": [
    {
      "kind": "prisma_bench",
      "path": "C:/Users/FITT/Documents/stage1_datasets"
    },
    {
      "kind": "implant",
      "path": "C:/es/implant/bench-v2"
    }
  ],
  "scorers": [
    {
      "kind": "residual_mahalanobis"
    },
    {
      "kind": "exclude",
      "classes": [
        "cloud"
      ],
      "segmenter": "FT03_ep10",
      "fit_on_kept": false,
      "base": {
        "kind": "residual_mahalanobis"
      }
    },
    {
      "kind": "exclude",
      "classes": [
        "water",
        "cloud"
      ],
      "segmenter": "FT03_ep10",
      "fit_on_kept": false,
      "base": {
        "kind": "residual_mahalanobis"
      }
    }
  ],
  "metrics": [
    {
      "kind": "roc_auc"
    },
    {
      "kind": "pauc",
      "max_fpr": 0.01
    },
    {
      "kind": "tpr_at",
      "fpr": 0.001
    },
    {
      "kind": "objects_caught",
      "top_pct": [
        1.0,
        0.1
      ]
