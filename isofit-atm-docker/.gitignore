# Patterns are anchored with a leading "/" where they mean one path. A bare
# directory name matches at any depth and can silently swallow source.

# Build output and staged DEM tiles (tens of GB) - regenerated by scripts/
/dist/

# Run logs written by `... | Tee-Object runNN.log`
/*.log

# Python bytecode
__pycache__/
*.pyc

# Editor / OS junk
.vscode/
.idea/
Thumbs.db
desktop.ini
Desktop.ini
.DS_Store

# Local env files
.env
.env.*
docker-compose.override.yml
